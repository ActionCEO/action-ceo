---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE, PAGES } from '../site';
const { page, title: t0, description: d0, path: p0, ogImage: og0, type = 'website', noindex = false, graph = [], article, overlay = false, canonical: c0 } = Astro.props;
const meta = page ? PAGES[page] : undefined;
const title = t0 ?? meta?.title;
const description = d0 ?? meta?.description;
const path = p0 ?? meta?.path ?? '/';
const BASE = (import.meta.env.SITE || SITE.url).replace(/\/$/, '');
// canonical can point at another page (an episode whose video already has a post).
const canonical = BASE + (c0 ?? (path === '/' ? '/' : path));
const ogImage = (SITE.shareImageBase || BASE) + (og0 ?? `/og/${page === 'home' ? 'home' : (path.replace(/^\//, '').replace(/\//g, '-') || 'home')}.png`);
// The nav sits outside <main>. Which item is marked current comes from the page's path.
const current = ([['/work', 'Work'], ['/shows', 'Shows'], ['/episodes', 'Shows'], ['/guests', 'Shows'], ['/speaking', 'Speaking'], ['/blog', 'Blog'], ['/about', 'About'], ['/contact', 'Contact']].find(([p]) => path === p || path.startsWith(p + '/')) ?? [])[1] ?? '';
const sameAs = [SITE.youtube, SITE.youtubeLfg, SITE.x, SITE.xLfg, SITE.linkedin, SITE.instagram, SITE.telegram].filter(Boolean);
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Person', '@id': `${BASE}/#person`, name: 'Action', alternateName: 'Victor Gazio', url: `${BASE}/`, image: `${BASE}/img/studio-smile.jpg`, jobTitle: 'Partner and Chief Communications Officer', worksFor: { '@id': `${BASE}/#lfg` }, mainEntityOfPage: { '@id': `${BASE}/about#webpage` }, sameAs },
    { '@type': 'Organization', '@id': `${BASE}/#lfg`, name: 'Laissez-Faire Group', alternateName: 'LFG', url: SITE.lfgUrl },
    { '@type': 'WebSite', '@id': `${BASE}/#website`, url: `${BASE}/`, name: 'Action', publisher: { '@id': `${BASE}/#person` }, inLanguage: 'en-US' },
    ...(graph.length ? graph : [{ '@type': page === 'about' ? 'ProfilePage' : 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: title, description, isPartOf: { '@id': `${BASE}/#website` }, about: { '@id': `${BASE}/#person` }, ...(page === 'about' ? { mainEntity: { '@id': `${BASE}/#person` } } : {}) }]),
  ],
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script is:inline>document.documentElement.classList.add('js')</script>
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
{noindex && <meta name="robots" content="noindex">}
<meta name="theme-color" content="#06111F">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.png" type="image/png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preload" href="/fonts/Montserrat_800ExtraBold.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/OpenSans_400Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="sitemap" href="/sitemap-index.xml">
<link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt">
<link rel="alternate" type="application/rss+xml" href="/rss.xml" title="Action: video blog">
<meta property="og:site_name" content="Action">
<meta property="og:type" content={type}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={title}>
<meta property="og:locale" content="en_US">
{article && <><meta property="article:published_time" content={article.published}><meta property="article:modified_time" content={article.modified}><meta property="article:author" content={`${BASE}/about`}>{article.tags.map((t) => <meta property="article:tag" content={t}>)}</>}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content={SITE.twitterHandle}>
<meta name="twitter:creator" content={SITE.twitterHandle}>
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<meta name="twitter:image:alt" content={title}>
<script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')}></script>
</head>
<body data-ga={SITE.ga4Id} data-pagefind-body={type === 'article' ? '' : undefined}>
<a class="skip" data-pagefind-ignore href="#content">Skip to content</a>
<Header nav current={current} overlay={overlay} />
<main id="main">
<slot />
</main>
<Footer />
<div class="consent" data-consent-banner hidden role="dialog" aria-label="Analytics consent">
  <p style="margin: 0; flex: 1 1 280px; font-size: 16px">OK to use Google Analytics to see which pages get read? <a href="/privacy" style="border-bottom: 1px solid #FFFFFF">Privacy</a></p>
  <div style="display: flex; gap: 12px"><button type="button" data-consent="no">No thanks</button><button type="button" data-consent="yes">OK</button></div>
</div>
<script src="../scripts/site.js"></script>
</body>
</html>
