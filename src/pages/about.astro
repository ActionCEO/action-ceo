---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import { SITE } from '../site';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import CallOut from '../components/CallOut.astro';
const story = [
  { label: 'Tech', year: '2005', title: 'I officially start in tech.', text: "I'd been editing video since I was 13. By 2005 I'm editing in Adobe Premiere, running Google Ads, reading Google Analytics and running my own eBay business. Crypto is still 7 years away." },
  { label: 'GE Healthcare', year: 'Fortune 500', title: 'Marketing at GE Healthcare.', text: `I did marketing at <a href="https://www.gehealthcare.com">GE Healthcare</a>, presented to leadership and ran webinars for major buyers. I put a quote system on the website, so buyers could get a price without calling a salesperson. That cut the cost of selling. I also trained support teams in India, the UK and Sweden on the software we shipped, and tested the license key checks so paid software wasn't given away. That's where my people skills started.` },
  { label: 'COO', year: '6 years', title: 'I ran a company.', text: `6 years as COO of a national education company that ran summer camps. I was the main speaker and the main negotiator. I negotiated our campus contracts with schools like <a href="https://www.upenn.edu">UPenn</a>, <a href="https://www.yale.edu">Yale</a>, <a href="https://www.ucla.edu">UCLA</a>, <a href="https://www.washington.edu">the University of Washington</a>, <a href="https://www.sandiego.edu">the University of San Diego</a>, <a href="https://www.hunschool.org">the Hun School of Princeton</a> and more. I even worked with a university in Singapore. I hired up to 250 people a year and owned the budget. When COVID sent everyone home, the camps stopped, and that chapter closed.` },
  { label: 'Crypto', year: '2012', title: 'I get into crypto.', text: `I started mining Bitcoin in 2012, and a year later I added Dogecoin and Litecoin. This was before seed phrases were standard. Your coins lived in a wallet file on your computer, and if you lost the file, you lost the coins. I lost a lot of crypto that way. Then <a href="https://en.wikipedia.org/wiki/Mt._Gox">Mt. Gox</a> went down, and I was there for that too. I learned those lessons the hard way, 9 years before Action Crypto existed, so you don't have to.` },
  { label: 'YouTube', year: '2021', title: 'I start Action Crypto.', text: `I started <a href="https://www.youtube.com/@ActionCrypto">the channel</a> to break this stuff down in plain English. A lot of it is DePIN: devices you plug in at home that earn while you sleep. Plug it in and let it rip. But I cover whatever is moving that week: <a href="/blog/tezos-copper-rwa-quantum-security">tokenized copper</a> and <a href="/blog/propbase-hotel-rental-income-rwa">hotel rooms</a>, <a href="/blog/canton-network-wall-street-blockchain">the blockchain Wall Street is actually using</a>, <a href="/blog/openai-revenue-gap-debt">OpenAI's debt</a>, <a href="/blog/jensen-huang-out-bitcoin-below-70k">Nvidia</a>, <a href="/blog/tesla-roadster-google-quantum-crypto">quantum computing</a>, <a href="/blog/action-items-binance-hack-brazil">the hack everyone is talking about</a>. I read the fine print, and I'll tell you when something doesn't add up. 1.6M+ views and 20.7K subscribers later, I'm still at it. In 2022 I joined Genzio to host <a href="/shows/genzio-roundtable">its live shows</a> and <a href="/shows/interviews">founder interviews</a>. In 2025 the Hashgraph team asked for me to host <a href="/speaking/hedera-livestreams">Hedera's community livestreams</a>.` },
  { label: 'DePIN Day', year: '2024, 2025', title: 'I organize and host events.', text: '<a href="/work/depin-day-seattle">DePIN Day: Seattle</a>. I co-organized it and hosted it, 2 years running. T-Mobile, HP and Borderless Capital on stage across 2024 and 2025. 65,000+ viewers on the X livestream. Watch <a href="/blog/depin-day-seattle-2024">2024</a> and <a href="/blog/depin-day-seattle-2025">2025</a>. Same stretch, I host livestreams for <a href="/speaking/karate-combat">Karate Combat</a>.' },
  { label: 'LFG', year: 'Now', title: 'Partner at Laissez-Faire Group.', text: `I'm a Partner and the Chief Communications Officer. <a href="/lfg">Go-to-market strategy, marketing and communications</a> sit with me, and I host the <a href="/shows/interviews">founder interviews on LFG Action</a>. I'm also live every Friday on <a href="/shows/action-items">Action Items</a>.` },
];
const steps = story.map((s) => ({ label: s.label }));
---
<Base page="about">
<Header current="About" />
<PageHero img="studio-smile" big={1156} w={1156} h={650} alt="Action smiling at his desk in the studio" pos="50% 25%" posPhone="50% 20%">
<h1 class="hero-h1">I ran a company. Then I started a channel.</h1>
<p class="hero-p">I'm Action. I've worked in tech since 2005 and been in crypto since 2012. For 6 years I was a COO, the main speaker and the main negotiator.</p>
</PageHero>

<section class="rv why-sec" aria-label="Why I break things down">
<p class="why-p">Breaking things down so everyone can follow matters more than people think. It was my job as a COO. It's my job now.</p>
</section>

<section class="rv story-sec" aria-label="My story" data-story>
<div class="story-wrap">
<div role="group" aria-label="Pick a chapter" class="story-steps">
{steps.map((st, i) => (<Fragment>
<button type="button" data-step={i} aria-pressed={i === 0 ? "true" : "false"} class="story-btn">{st.label}</button>
</Fragment>))}
</div>
<div class="story-panels">
{story.map((c, i) => (<Fragment>
<div class="stepin story-panel" data-panel={i}>
<div class="story-year">{c.year}</div>
<h2 class="story-h">{c.title}</h2>
<p class="story-text" set:html={c.text}></p>
</div>
</Fragment>))}
</div>
</div>
</section>

<div class="clip">
<picture class="pic"><source type="image/avif" srcset="/img/depin-wide-800.avif 800w, /img/depin-wide-1456.avif 1456w" sizes="100vw"><source type="image/webp" srcset="/img/depin-wide-800.webp 800w, /img/depin-wide-1456.webp 1456w" sizes="100vw"><img src="/img/depin-wide.jpg" width="1456" height="813" loading="lazy" decoding="async" class="par wide-img"  alt="Action on stage at DePIN Day: Seattle, holding a microphone"></picture>
</div>

<section class="rv today" aria-label="Today">
<div class="legal-row">
<h2 class="item-h today-k">Day job</h2>
<p class="today-v">I'm a Partner and the Chief Communications Officer at Laissez-Faire Group. Go-to-market strategy, marketing and communications sit with me, for teams in Web3, DePIN, fintech and decentralized AI. If you're launching, that's who you call. <a href="/lfg" class="go uline">Work with LFG</a></p>
</div>
<div class="legal-row">
<h2 class="item-h today-k">On camera</h2>
<p class="today-v">2 channels. {SITE.channel} is me and my opinions. LFG Action is me asking founders and builders the questions. 989 videos between them. <a href="/shows" class="go uline">See all the shows</a>
<span class="btn-row"><a href={`${SITE.youtube}?sub_confirmation=1`} rel="noopener" title={`Subscribe to ${SITE.channel} on YouTube`} class="btn-line ext"><Icon name="youtube" size={22} />Subscribe to {SITE.channel}<span class="sr">, opens in a new tab</span></a><a href={`${SITE.youtubeLfg}?sub_confirmation=1`} rel="noopener" title="Subscribe to LFG Action on YouTube" class="btn-line ext"><Icon name="youtube" size={22} />Subscribe to LFG Action<span class="sr">, opens in a new tab</span></a></span></p>
</div>
<div class="legal-row">
<h2 class="item-h today-k">Home base</h2>
<p class="today-v">San Diego, California.</p>
</div>
</section>
<CallOut lines={["That's the story.", 'The videos are better.']} links={[
  { label: `Watch ${SITE.channel}`, href: SITE.youtube, icon: 'youtube', title: `${SITE.channel} on YouTube` },
  { label: 'Book me to host or speak', href: '/speaking#book', icon: 'mail' },
]} />
</Base>
