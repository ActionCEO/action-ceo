---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { SITE } from '../../site';

---
<Base page="speaking">
<Header current="Speaking" />
<header style="position: relative; min-height: 640px; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden">
<picture style="display: contents"><source type="image/avif" srcset="/img/stage-keynote-800.avif 800w, /img/stage-keynote-1456.avif 1456w" sizes="100vw"><source type="image/webp" srcset="/img/stage-keynote-800.webp 800w, /img/stage-keynote-1456.webp 1456w" sizes="100vw"><img src="/img/stage-keynote.jpg" width="1456" height="813" loading="eager" fetchpriority="high" decoding="async" class="hero-img" alt="Action speaking on a conference stage with a microphone" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 30%"></picture>
<div aria-hidden="true" style="position: absolute; inset: 0; background: linear-gradient(to top, #06111F 4%, rgba(6,17,31,0.72) 45%, rgba(6,17,31,0.35) 100%)"></div>
<div style="position: relative; padding: 0 clamp(20px, 4.5vw, 64px) 56px; display: flex; flex-direction: column; gap: 24px; align-items: flex-start">
<h1 style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: clamp(44px, 7vw, 108px); line-height: 1.02; letter-spacing: -0.035em; ">Put me on stage.</h1>
<p style="margin: 0; max-width: 600px; font-size: 20px">I host and I speak. I co-organized and hosted DePIN Day: Seattle. I keep it in plain English so the whole room follows.</p>
<a href="#book" style="font-weight: 600; padding: 10px 0; border-bottom: 1px solid #FFFFFF">Book me</a>
</div>
</header>
<section aria-label="Past events" style="padding: 96px clamp(20px, 4.5vw, 64px) 40px">
<h2 style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: clamp(28px, 3.2vw, 44px); line-height: 1.02; letter-spacing: -0.035em; ">Stages and streams so far</h2>
<div style="margin-top: 32px">
<article class="rv" style="display: flex; flex-wrap: wrap; gap: 20px 48px; padding: 36px 0; border-top: 1px solid #0A2C52; align-items: center">
<div style="flex: 0 1 140px; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: 22px; font-variant-numeric: tabular-nums">2024 and 2025</div>
<div style="flex: 3 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 6px"><h3 style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: clamp(24px, 3vw, 40px); line-height: 1.02; letter-spacing: -0.035em; "><a href="/work/depin-day-seattle" style="border-bottom: 1px solid #FFFFFF">DePIN Day: Seattle</a></h3><p style="margin: 0; color: #D5D8DB; font-size: 19px">Co-organized and hosted, 2 years running. T-Mobile, HP and Borderless Capital on stage across 2024 and 2025. 65,000+ viewers on the X livestream. </p><p style="margin: 6px 0 0; display: flex; flex-wrap: wrap; gap: 4px 24px"><a href="/speaking/depin-day-seattle-2024" style="font-weight: 600; padding: 8px 0; border-bottom: 1px solid #FFFFFF">Watch 2024</a><a href="/speaking/depin-day-seattle-2025" style="font-weight: 600; padding: 8px 0; border-bottom: 1px solid #FFFFFF">Watch 2025</a></p></div>
<picture style="display: contents"><source type="image/avif" srcset="/img/depin-stage-800.avif 800w, /img/depin-stage-1456.avif 1456w" sizes="(max-width: 800px) 100vw, 1600px"><source type="image/webp" srcset="/img/depin-stage-800.webp 800w, /img/depin-stage-1456.webp 1456w" sizes="(max-width: 800px) 100vw, 1600px"><img src="/img/depin-stage.jpg" width="1456" height="727" loading="lazy" decoding="async" alt="The DePIN Day: Seattle stage from the back of the room" class="ci" style="flex: 1 1 280px; min-width: 0; max-width: 460px; width: 100%; aspect-ratio: 16 / 9; object-fit: cover"></picture>
</article>
<article class="rv" style="display: flex; flex-wrap: wrap; gap: 20px 48px; padding: 36px 0; border-top: 1px solid #0A2C52; align-items: center">
<div style="flex: 0 1 140px; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: 22px; font-variant-numeric: tabular-nums">2024 to 2025</div>
<div style="flex: 3 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 6px"><h3 style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: clamp(24px, 3vw, 40px); line-height: 1.02; letter-spacing: -0.035em; "><a href="/speaking/karate-combat" style="border-bottom: 1px solid #FFFFFF">Karate Combat</a></h3><p style="margin: 0; color: #D5D8DB; font-size: 19px">I hosted the pit side livestreams, calling fights live from next to the pit.</p></div>
<picture style="display: contents"><source type="image/avif" srcset="/img/kc-pitside-800.avif 800w, /img/kc-pitside-1456.avif 1456w" sizes="(max-width: 800px) 100vw, 460px"><source type="image/webp" srcset="/img/kc-pitside-800.webp 800w, /img/kc-pitside-1456.webp 1456w" sizes="(max-width: 800px) 100vw, 460px"><img src="/img/kc-pitside.jpg" width="1456" height="813" loading="lazy" decoding="async" class="ci" alt="Action commentating pitside at a Karate Combat event" style="flex: 1 1 280px; min-width: 0; max-width: 460px; width: 100%; aspect-ratio: 16 / 9; object-fit: cover"></picture>
</article>
<article class="rv" style="display: flex; flex-wrap: wrap; gap: 20px 48px; padding: 36px 0; border-top: 1px solid #0A2C52; align-items: center">
<div style="flex: 0 1 140px; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: 22px; font-variant-numeric: tabular-nums">2024</div>
<div style="flex: 3 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 6px"><h3 style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: clamp(24px, 3vw, 40px); line-height: 1.02; letter-spacing: -0.035em; "><a href="/speaking/derec-alliance" style="border-bottom: 1px solid #FFFFFF">DeRec Alliance</a></h3><p style="margin: 0; color: #D5D8DB; font-size: 19px">I hosted the DeRec Alliance community call on Hedera's YouTube channel. It's the featured video on derec.org.</p></div>
<img src="https://i.ytimg.com/vi/qr5dz0QqCK0/hqdefault.jpg" width="480" height="360" loading="lazy" decoding="async" class="ci" alt="Thumbnail of the DeRec Alliance community call hosted by Action" style="flex: 1 1 280px; min-width: 0; max-width: 460px; width: 100%; aspect-ratio: 16 / 9; object-fit: cover">
</article>
</div>
</section>
<section class="rv" aria-label="Topics" style="padding: 56px clamp(20px, 4.5vw, 64px) 96px">
<h2 style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: clamp(28px, 3.2vw, 44px); line-height: 1.02; letter-spacing: -0.035em; ">What I talk about</h2>
<p style="margin: 0; max-width: 760px; font-size: 20px; color: #D5D8DB">AI, DePIN, crypto and go-to-market. All of it in plain English.</p>
</section>
<section class="rv" id="book" aria-label="Booking form" style="background: #002346; padding: 96px clamp(20px, 4.5vw, 64px); display: flex; flex-wrap: wrap; gap: 40px 64px">
<div style="flex: 1 1 320px; display: flex; flex-direction: column; gap: 16px">
<h2 style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: clamp(34px, 4.8vw, 68px); line-height: 1.02; letter-spacing: -0.035em; ">Book me</h2>
<p style="margin: 0; max-width: 420px; font-size: 19px; color: #E3E6E9">Tell me about the event. The more detail, the faster I can say yes.</p>
</div>
<form data-form method="post" action="/api/contact" novalidate style="flex: 2 1 480px; min-width: 0; max-width: 720px; display: flex; flex-direction: column; gap: 20px">
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 20px">
<div style="display: flex; flex-direction: column; gap: 8px"><label for="sp-name" style="font-weight: 600; font-size: 16px">Your name</label><input id="sp-name" name="name" type="text" required autocomplete="name" placeholder="" style="box-sizing: border-box; width: 100%; min-height: 52px; padding: 14px 16px; background: #0A2C52; border: 1px solid #A5AAAF; border-radius: 2px; color: #FFFFFF; font-family: 'Open Sans', Arial, sans-serif; font-size: 17px"></div><div style="display: flex; flex-direction: column; gap: 8px"><label for="sp-email" style="font-weight: 600; font-size: 16px">Email</label><input id="sp-email" name="email" type="email" required autocomplete="email" placeholder="" style="box-sizing: border-box; width: 100%; min-height: 52px; padding: 14px 16px; background: #0A2C52; border: 1px solid #A5AAAF; border-radius: 2px; color: #FFFFFF; font-family: 'Open Sans', Arial, sans-serif; font-size: 17px"></div><div style="display: flex; flex-direction: column; gap: 8px"><label for="sp-event" style="font-weight: 600; font-size: 16px">Event name</label><input id="sp-event" name="event" type="text" placeholder="" style="box-sizing: border-box; width: 100%; min-height: 52px; padding: 14px 16px; background: #0A2C52; border: 1px solid #A5AAAF; border-radius: 2px; color: #FFFFFF; font-family: 'Open Sans', Arial, sans-serif; font-size: 17px"></div><div style="display: flex; flex-direction: column; gap: 8px"><label for="sp-date" style="font-weight: 600; font-size: 16px">Event date (a rough date is fine)</label><input id="sp-date" name="date" type="text" placeholder="Month and year" style="box-sizing: border-box; width: 100%; min-height: 52px; padding: 14px 16px; background: #0A2C52; border: 1px solid #A5AAAF; border-radius: 2px; color: #FFFFFF; font-family: 'Open Sans', Arial, sans-serif; font-size: 17px"></div>
</div>
<div style="display: flex; flex-direction: column; gap: 8px"><label for="sp-type" style="font-weight: 600; font-size: 16px">What do you need?</label><select id="sp-type" name="need" style="box-sizing: border-box; width: 100%; min-height: 52px; padding: 14px 16px; background: #0A2C52; border: 1px solid #A5AAAF; border-radius: 2px; color: #FFFFFF; font-family: 'Open Sans', Arial, sans-serif; font-size: 17px"><option>A speaker</option><option>An event host</option><option>A livestream host</option><option>Something else</option></select></div><div style="display: flex; flex-direction: column; gap: 8px"><label for="sp-msg" style="font-weight: 600; font-size: 16px">Audience, format and anything else I should know</label><textarea id="sp-msg" name="message" required rows="5" placeholder="Audience, location, budget, anything useful" style="box-sizing: border-box; width: 100%; min-height: 52px; padding: 14px 16px; background: #0A2C52; border: 1px solid #A5AAAF; border-radius: 2px; color: #FFFFFF; font-family: 'Open Sans', Arial, sans-serif; font-size: 17px"></textarea></div><input type="hidden" name="type" value="Speaking"><div style="display: flex; gap: 12px; align-items: flex-start"><input id="sp-ok" name="consent" type="checkbox" required style="width: 22px; height: 22px; margin-top: 2px"><label for="sp-ok" style="font-size: 16px; color: #D5D8DB">OK to email me back about this. See the <a href="/privacy" style="border-bottom: 1px solid #FFFFFF">privacy page</a>.</label></div>
<div class="cf-turnstile" data-sitekey={SITE.turnstileSiteKey} data-theme="dark"></div><input type="hidden" name="consent_version" value={SITE.consentVersion}><input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position: absolute; left: -9999px"><p data-form-status role="status" aria-live="polite" style="margin: 0; min-height: 26px; font-weight: 600"></p><button type="submit" style="align-self: flex-start; background: #69BE28; color: #06111F; border: 0; border-radius: 2px; cursor: pointer; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: 16px; padding: 16px 28px; min-height: 52px">Send booking request</button>
</form>
</section>
</Base>
