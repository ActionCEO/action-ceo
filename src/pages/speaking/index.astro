---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { SITE } from '../../site';
import Icon from '../../components/Icon.astro';
// Featured: events with their own page and a picture. The picture and the title both open the page.
const featured = [
  { name: 'DePIN Day: Seattle', href: '/work/depin-day-seattle', text: 'Co-organized and hosted, 2 years running. T-Mobile, HP and Borderless Capital on stage across 2024 and 2025. 65,000+ viewers on the X livestream.', img: 'depin-wide', big: 1456, alt: 'Action speaking on the DePIN Day: Seattle stage', links: [['Watch 2024', '/blog/depin-day-seattle-2024'], ['Watch 2025', '/blog/depin-day-seattle-2025']] },
  { name: 'Karate Combat', href: '/speaking/karate-combat', text: 'I hosted the pit side livestreams, calling fights live from next to the pit.', img: 'kc-pit side', big: 1456, alt: 'Action commentating pit side at a Karate Combat event' },
  { name: 'DeRec Alliance', href: '/speaking/derec-alliance', text: "I hosted the DeRec Alliance community call on Hedera's YouTube channel. It's the featured video on derec.org.", yt: 'qr5dz0QqCK0', alt: 'Thumbnail of the DeRec Alliance community call hosted by Action' },
];
// Conferences: no dates on purpose (Action does not go every year). Add a row here when there is a new one.
const conferences = [
  { name: 'DCENTRAL', what: 'Speaker' },
  { name: 'ETHDenver', what: 'Stage host, and I ran their X Spaces' },
  { name: 'TOKEN2049', what: 'Founder interviews on site, including io.net' },
  { name: 'Bitcoin Conference', what: 'Interviews with founders and teams, 3 years running' },
];
const topics = ['AI', 'DePIN', 'Crypto', 'RWAs', 'Commodities', 'Go-to-market'];

---
<Base page="speaking">
<Header current="Speaking" />
<header class="sp-head">
<picture class="pic"><source type="image/avif" srcset="/img/stage-keynote-800.avif 800w, /img/stage-keynote-1456.avif 1456w" sizes="100vw"><source type="image/webp" srcset="/img/stage-keynote-800.webp 800w, /img/stage-keynote-1456.webp 1456w" sizes="100vw"><img src="/img/stage-keynote.jpg" width="1456" height="813" loading="eager" fetchpriority="high" decoding="async" class="hero-img sp-hero fill" alt="Action speaking on a conference stage with a microphone"></picture>
<div class="sp-shade" aria-hidden="true"></div>
<div class="sp-head-text">
<h1 class="legal-h1">Put me on stage.</h1>
<p class="sp-lead">I host and I speak. I co-organized and hosted DePIN Day: Seattle, spoke at DCENTRAL, hosted stages at ETHDenver, and ran founder interviews at TOKEN2049 and the Bitcoin Conference. I keep it in plain English so the whole room follows.</p>
<a href="#book" class="cta-link"><Icon name="mail" size={26} />Book me</a>
</div>
</header>
<section class="sp-past" aria-label="Past events">
<h2 class="sec-h">Stages, conferences and streams</h2>
<div>
{featured.map((f) => (
<article class="rv sp-item">
<div class="sp-text"><h3 class="item-h"><a href={f.href}>{f.name}</a></h3><p class="para">{f.text}</p>
<p class="links2 sp-links">{(f.links ?? [['See more', f.href]]).map(([label, href]) => <a href={href} class="go ulink ulink-8">{label}</a>)}</p></div>
<a href={f.href} class="sp-media" aria-hidden="true" tabindex="-1">{f.yt
  ? <img src={`https://i.ytimg.com/vi/${f.yt}/sddefault.jpg`} width="640" height="480" loading="lazy" decoding="async" alt={f.alt}>
  : <picture class="pic"><source type="image/avif" srcset={`/img/${f.img}-800.avif 800w, /img/${f.img}-${f.big}.avif ${f.big}w`} sizes="(max-width: 900px) 100vw, 420px"><source type="image/webp" srcset={`/img/${f.img}-800.webp 800w, /img/${f.img}-${f.big}.webp ${f.big}w`} sizes="(max-width: 900px) 100vw, 420px"><img src={`/img/${f.img}.jpg`} width="1456" height="813" loading="lazy" decoding="async" alt={f.alt}></picture>}</a>
</article>
))}
</div>
<h3 class="label-h rv">Conferences</h3>
<ul class="rows bare" role="list">
{conferences.map((c) => (
<li class="row row-flat"><span class="row-main"><span class="row-name">{c.name}</span><span class="row-role">{c.what}</span></span></li>
))}
</ul>
</section>
<section class="rv sp-topics" aria-label="Topics">
<h2 class="sec-h sec-h-tight">What I talk about</h2>
<ul class="tags tags-lg" aria-label="Topics">{topics.map((t) => <li>{t}</li>)}</ul>
<p class="para-20">All of it in plain English.</p>
</section>
<section class="rv ct-grid ct-book" id="book" aria-label="Booking form">
<div class="ct-side">
<h2 class="sec-h sec-h-12">Book me.</h2>
<p class="ct-lead">Tell me about the event. The more detail, the faster I can say yes.</p>
<ul role="list" class="ct-picks">
<li><button type="button" class="ct-pick" data-pick="A speaker" data-pick-for="sp-type" aria-controls="sp-type" disabled><span class="ct-pick-h">A speaker</span><span class="ct-pick-d">A talk, a panel seat or a fireside chat on AI, DePIN, crypto or RWAs.</span></button></li>
<li><button type="button" class="ct-pick" data-pick="An event host" data-pick-for="sp-type" aria-controls="sp-type" disabled><span class="ct-pick-h">An event host</span><span class="ct-pick-d">I run the stage, keep the day on time and keep the room awake.</span></button></li>
<li><button type="button" class="ct-pick" data-pick="A livestream host" data-pick-for="sp-type" aria-controls="sp-type" disabled><span class="ct-pick-h">A livestream host</span><span class="ct-pick-d">Your stream, show or X Space, with the chat part of it.</span></button></li>
<li><button type="button" class="ct-pick" data-pick="Something else" data-pick-for="sp-type" aria-controls="sp-type" disabled><span class="ct-pick-h">Something else</span><span class="ct-pick-d">Tell me what you have in mind.</span></button></li>
</ul>
<p class="ct-note">Prefer email? <a class="uline" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
</div>
<form data-form method="post" action="/api/contact" novalidate class="ct-form">
<div class="form-grid">
<div class="stack"><label class="field-l" for="sp-name">Your name</label><input class="field" id="sp-name" name="name" type="text" required autocomplete="name" placeholder=""></div><div class="stack"><label class="field-l" for="sp-email">Email</label><input class="field" id="sp-email" name="email" type="email" required autocomplete="email" placeholder=""></div><div class="stack"><label class="field-l" for="sp-event">Event name</label><input class="field" id="sp-event" name="event" type="text" placeholder=""></div><div class="stack"><label class="field-l" for="sp-date">Event date (a rough date is fine)</label><input class="field" id="sp-date" name="date" type="text" placeholder="Month and year"></div>
</div>
<div class="stack"><label class="field-l" for="sp-type">What do you need?</label><select class="field" id="sp-type" name="need"><option>A speaker</option><option>An event host</option><option>A livestream host</option><option>Something else</option></select></div><div class="stack"><label class="field-l" for="sp-msg">Audience, format and anything else I should know</label><textarea class="field" id="sp-msg" name="message" required rows="5" placeholder="Audience, location, budget, anything useful"></textarea></div><input type="hidden" name="type" value="Speaking"><div class="check-row"><input class="check" id="sp-ok" name="consent" type="checkbox" required><label class="check-l" for="sp-ok">OK to email me back about this. See the <a class="uline" href="/privacy">terms and privacy page</a>.</label></div>
<div class="cf-turnstile" data-sitekey={SITE.turnstileSiteKey} data-theme="dark"></div><input type="hidden" name="consent_version" value={SITE.consentVersion}><input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true"><p class="form-status" data-form-status role="status" aria-live="polite"></p><button class="btn-send" type="submit">Send booking request</button>
</form>
</section>
</Base>
