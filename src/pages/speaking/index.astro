---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { SITE } from '../../site';
import Icon from '../../components/Icon.astro';
// Featured: events with their own page and a picture. The picture and the title both open the page.
const featured = [
  { name: 'DePIN Day: Seattle', href: '/work/depin-day-seattle', text: 'Co-organized and hosted, 2 years running. T-Mobile, HP and Borderless Capital on stage across 2024 and 2025. 65,000+ viewers on the X livestream.', img: 'depin-wide', big: 1456, alt: 'Action speaking on the DePIN Day: Seattle stage', links: [['Watch 2024', '/speaking/depin-day-seattle-2024'], ['Watch 2025', '/speaking/depin-day-seattle-2025']] },
  { name: 'Karate Combat', href: '/speaking/karate-combat', text: 'I hosted the pit side livestreams, calling fights live from next to the pit.', img: 'kc-pitside', big: 1456, alt: 'Action commentating pitside at a Karate Combat event' },
  { name: 'DeRec Alliance', href: '/speaking/derec-alliance', text: "I hosted the DeRec Alliance community call on Hedera's YouTube channel. It's the featured video on derec.org.", yt: 'qr5dz0QqCK0', alt: 'Thumbnail of the DeRec Alliance community call hosted by Action' },
];
// Conferences: no dates on purpose (Action does not go every year). Add a row here when there is a new one.
const conferences = [
  { name: 'DCENTRAL', what: 'Speaker' },
  { name: 'ETHDenver', what: 'Stage host, and I ran their X Spaces' },
  { name: 'TOKEN2049', what: 'Founder interviews on site, including io.net' },
  { name: 'Bitcoin Conference', what: 'Interviews with founders and teams, 3 years running' },
];
const topics = ['AI', 'DePIN', 'Crypto', 'RWAs', 'Commodities', 'Go-to-market'];

---
<Base page="speaking">
<Header current="Speaking" />
<header style="position: relative; min-height: 640px; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden">
<picture style="display: contents"><source type="image/avif" srcset="/img/stage-keynote-800.avif 800w, /img/stage-keynote-1456.avif 1456w" sizes="100vw"><source type="image/webp" srcset="/img/stage-keynote-800.webp 800w, /img/stage-keynote-1456.webp 1456w" sizes="100vw"><img src="/img/stage-keynote.jpg" width="1456" height="813" loading="eager" fetchpriority="high" decoding="async" class="hero-img sp-hero" alt="Action speaking on a conference stage with a microphone" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover"></picture>
<div aria-hidden="true" style="position: absolute; inset: 0; background: linear-gradient(to top, #06111F 4%, rgba(6,17,31,0.72) 45%, rgba(6,17,31,0.35) 100%)"></div>
<div style="position: relative; padding: 0 clamp(20px, 4.5vw, 64px) 56px; display: flex; flex-direction: column; gap: 24px; align-items: flex-start">
<h1 style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: clamp(44px, 7vw, 108px); line-height: 1.02; letter-spacing: -0.035em; ">Put me on stage.</h1>
<p style="margin: 0; max-width: 680px; font-size: 20px">I host and I speak. I co-organized and hosted DePIN Day: Seattle, spoke at DCENTRAL, hosted stages at ETHDenver, and ran founder interviews at TOKEN2049 and the Bitcoin Conference. I keep it in plain English so the whole room follows.</p>
<a href="#book" class="cta-link"><Icon name="mail" size={26} />Book me</a>
</div>
</header>
<section aria-label="Past events" style="padding: clamp(64px, 8vw, 96px) clamp(20px, 4.5vw, 64px) 40px">
<h2 class="sec-h">Stages, conferences and streams</h2>
<div>
{featured.map((f) => (
<article class="rv sp-item">
<div class="sp-text"><h3 class="item-h"><a href={f.href}>{f.name}</a></h3><p style="margin: 0; color: #D5D8DB; font-size: 19px">{f.text}</p>
<p class="links2" style="margin: 6px 0 0">{(f.links ?? [['See more', f.href]]).map(([label, href]) => <a href={href} class="go" style="font-weight: 600; padding: 8px 0; border-bottom: 1px solid #FFFFFF">{label}</a>)}</p></div>
<a href={f.href} class="sp-media" aria-hidden="true" tabindex="-1">{f.yt
  ? <img src={`https://i.ytimg.com/vi/${f.yt}/sddefault.jpg`} width="640" height="480" loading="lazy" decoding="async" alt={f.alt}>
  : <picture style="display: contents"><source type="image/avif" srcset={`/img/${f.img}-800.avif 800w, /img/${f.img}-${f.big}.avif ${f.big}w`} sizes="(max-width: 900px) 100vw, 420px"><source type="image/webp" srcset={`/img/${f.img}-800.webp 800w, /img/${f.img}-${f.big}.webp ${f.big}w`} sizes="(max-width: 900px) 100vw, 420px"><img src={`/img/${f.img}.jpg`} width="1456" height="813" loading="lazy" decoding="async" alt={f.alt}></picture>}</a>
</article>
))}
</div>
<h3 class="label-h rv">Conferences</h3>
<ul class="rows" role="list" style="list-style: none; margin: 0; padding: 0">
{conferences.map((c) => (
<li class="row row-flat"><span class="row-main"><span class="row-name">{c.name}</span><span class="row-role">{c.what}</span></span></li>
))}
</ul>
</section>
<section class="rv" aria-label="Topics" style="padding: 56px clamp(20px, 4.5vw, 64px) 96px; display: flex; flex-direction: column; gap: 20px; align-items: flex-start">
<h2 class="sec-h" style="margin-bottom: 8px">What I talk about</h2>
<ul class="tags tags-lg" aria-label="Topics">{topics.map((t) => <li>{t}</li>)}</ul>
<p style="margin: 0; font-size: 20px; color: #D5D8DB">All of it in plain English.</p>
</section>
<section class="rv" id="book" aria-label="Booking form" style="background: #002346; padding: 96px clamp(20px, 4.5vw, 64px); display: flex; flex-wrap: wrap; gap: 40px 64px">
<div style="flex: 1 1 320px; display: flex; flex-direction: column; gap: 16px">
<h2 class="callout-h">Book me</h2>
<p style="margin: 0; max-width: 420px; font-size: 19px; color: #E3E6E9">Tell me about the event. The more detail, the faster I can say yes.</p>
</div>
<form data-form method="post" action="/api/contact" novalidate style="flex: 2 1 480px; min-width: 0; max-width: 720px; display: flex; flex-direction: column; gap: 20px">
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 20px">
<div style="display: flex; flex-direction: column; gap: 8px"><label for="sp-name" style="font-weight: 600; font-size: 16px">Your name</label><input id="sp-name" name="name" type="text" required autocomplete="name" placeholder="" style="box-sizing: border-box; width: 100%; min-height: 52px; padding: 14px 16px; background: #0A2C52; border: 1px solid #A5AAAF; border-radius: 2px; color: #FFFFFF; font-family: 'Open Sans', Arial, sans-serif; font-size: 17px"></div><div style="display: flex; flex-direction: column; gap: 8px"><label for="sp-email" style="font-weight: 600; font-size: 16px">Email</label><input id="sp-email" name="email" type="email" required autocomplete="email" placeholder="" style="box-sizing: border-box; width: 100%; min-height: 52px; padding: 14px 16px; background: #0A2C52; border: 1px solid #A5AAAF; border-radius: 2px; color: #FFFFFF; font-family: 'Open Sans', Arial, sans-serif; font-size: 17px"></div><div style="display: flex; flex-direction: column; gap: 8px"><label for="sp-event" style="font-weight: 600; font-size: 16px">Event name</label><input id="sp-event" name="event" type="text" placeholder="" style="box-sizing: border-box; width: 100%; min-height: 52px; padding: 14px 16px; background: #0A2C52; border: 1px solid #A5AAAF; border-radius: 2px; color: #FFFFFF; font-family: 'Open Sans', Arial, sans-serif; font-size: 17px"></div><div style="display: flex; flex-direction: column; gap: 8px"><label for="sp-date" style="font-weight: 600; font-size: 16px">Event date (a rough date is fine)</label><input id="sp-date" name="date" type="text" placeholder="Month and year" style="box-sizing: border-box; width: 100%; min-height: 52px; padding: 14px 16px; background: #0A2C52; border: 1px solid #A5AAAF; border-radius: 2px; color: #FFFFFF; font-family: 'Open Sans', Arial, sans-serif; font-size: 17px"></div>
</div>
<div style="display: flex; flex-direction: column; gap: 8px"><label for="sp-type" style="font-weight: 600; font-size: 16px">What do you need?</label><select id="sp-type" name="need" style="box-sizing: border-box; width: 100%; min-height: 52px; padding: 14px 16px; background: #0A2C52; border: 1px solid #A5AAAF; border-radius: 2px; color: #FFFFFF; font-family: 'Open Sans', Arial, sans-serif; font-size: 17px"><option>A speaker</option><option>An event host</option><option>A livestream host</option><option>Something else</option></select></div><div style="display: flex; flex-direction: column; gap: 8px"><label for="sp-msg" style="font-weight: 600; font-size: 16px">Audience, format and anything else I should know</label><textarea id="sp-msg" name="message" required rows="5" placeholder="Audience, location, budget, anything useful" style="box-sizing: border-box; width: 100%; min-height: 52px; padding: 14px 16px; background: #0A2C52; border: 1px solid #A5AAAF; border-radius: 2px; color: #FFFFFF; font-family: 'Open Sans', Arial, sans-serif; font-size: 17px"></textarea></div><input type="hidden" name="type" value="Speaking"><div style="display: flex; gap: 12px; align-items: flex-start"><input id="sp-ok" name="consent" type="checkbox" required style="width: 22px; height: 22px; margin-top: 2px"><label for="sp-ok" style="font-size: 16px; color: #D5D8DB">OK to email me back about this. See the <a href="/privacy" style="border-bottom: 1px solid #FFFFFF">privacy page</a>.</label></div>
<div class="cf-turnstile" data-sitekey={SITE.turnstileSiteKey} data-theme="dark"></div><input type="hidden" name="consent_version" value={SITE.consentVersion}><input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position: absolute; left: -9999px"><p data-form-status role="status" aria-live="polite" style="margin: 0; min-height: 26px; font-weight: 600"></p><button type="submit" style="align-self: flex-start; background: #69BE28; color: #06111F; border: 0; border-radius: 2px; cursor: pointer; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: 16px; padding: 16px 28px; min-height: 52px">Send booking request</button>
</form>
</section>
</Base>
