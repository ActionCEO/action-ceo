---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { SITE } from '../../site';
import { getCollection, getEntry, render } from 'astro:content';
import Video from '../../components/Video.astro';
import PageHero from '../../components/PageHero.astro';
import CallOut from '../../components/CallOut.astro';
import { livePosts } from '../../lib/content';
export async function getStaticPaths() { return (await getCollection('speaking')).map((e) => ({ params: { slug: e.id }, props: { e } })); }
const { e } = Astro.props;
const { Content } = await render(e);
const video = e.data.video ? await getEntry(e.data.video) : null;
const post = video ? (await livePosts()).find((p) => p.data.video.id === video.id) : null;
// Header photo per page. Rule from Action: no AI-made image on a page that shows real footage of the same event.
// kc-pitside is AI-made, so the Karate Combat page carries no real stills until sharp ones are pulled from the streams.
const HERO: Record<string, { img: string; big: number; w: number; h: number; alt: string; pos: string; posPhone?: string }> = {
  'karate-combat': { img: 'kc-pitside', big: 1456, w: 1456, h: 813, alt: 'Action commentating pit side at Karate Combat', pos: '74% 35%', posPhone: '74% 25%' },
};
const hero = HERO[e.id] ?? { img: 'studio-interview', big: 1156, w: 1156, h: 650, alt: 'Action in his studio during an interview', pos: '50% 25%', posPhone: '50% 20%' };
const BASE = (import.meta.env.SITE || SITE.url).replace(/\/$/, '');
const url = `${BASE}/speaking/${e.id}`;
// Search titles, descriptions and button wording, 1 per page. A page without an entry gets the plain fallback.
const META: Record<string, { title: string; description: string; cta: string; project?: string }> = {
  'hedera-livestreams': { title: "Hedera Livestreams | Hosted by Action in 2025", description: "Action hosted Hedera's community livestreams in 2025 at the request of the Hashgraph team, with founders from HashPack, Bonzo Finance, DOVU and LinkPool.", cta: 'Book me to host your stream' },
  'karate-combat': { title: 'Karate Combat | Action, Livestream Host', description: 'Action hosted the Karate Combat pit side livestreams from 2024 to 2025 and turned an open-license stream into a show crypto sponsors paid for.', cta: 'Book me to host your stream' },
  'derec-alliance': { title: 'DeRec Alliance Call | Action, Livestream Host', description: 'Action hosted the DeRec Alliance community call on Hedera\'s YouTube channel, the featured video on derec.org. Watch it here and book Action.', cta: 'Book me to host your stream' },
};
const m = META[e.id];
const title = m?.title ?? `${e.data.event.slice(0, 30)} ${e.data.year} | Action Speaking`;
const desc = m?.description ?? `${e.data.event} (${e.data.year}). ${e.data.role} Book Action to speak or host at your event.`.padEnd(70, ' ').slice(0, 155);
const graph = [{ '@type': 'WebPage', '@id': `${url}#webpage`, url, name: e.data.event, isPartOf: { '@id': `${BASE}/#website` } },
  ...(e.data.publicInPerson && e.data.startDate ? [{ '@type': 'Event', '@id': `${url}#event`, name: e.data.event, startDate: e.data.startDate.toISOString(), eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode', location: { '@type': 'Place', name: e.data.location ?? e.data.event }, performer: { '@id': `${BASE}/#person` } }] : [])];
---
<Base title={title} description={desc} path={`/speaking/${e.id}`} ogImage="/og/speaking.png" graph={graph}>
<Header current="Speaking" />
<PageHero img={hero.img} big={hero.big} w={hero.w} h={hero.h} alt={hero.alt} pos={hero.pos} posPhone={hero.posPhone}>
<a href="/speaking" class="hero-back">« All speaking</a>
{e.id === 'karate-combat' && <img src="/img/kc-wordmark-white.png" width="1053" height="249" alt="Karate Combat logo" class="hero-logo">}
<h1 class="hero-h1">{e.data.event}</h1>
<p class="hero-year">{e.data.year}</p>
<p class="hero-p">{e.data.role}</p>
</PageHero>
<section class="rv pad sec sp-body">
  <div class="prose sp-prose"><Content /></div>
  {video && <div class="sp-video"><Video id={video.data.youtubeId} title={video.data.title} />{post && <a href={`/blog/${post.id}`} class="btn-line go">Read the write-up</a>}</div>}
</section>
{e.data.highlights.length > 0 && <section class="rv pad sec alt" aria-labelledby="hl-h">
  <h2 class="sec-h" id="hl-h">What made it work</h2>
  <ul role="list" class="cards4">{e.data.highlights.map((h) => <li class="card"><h3 class="item-h">{h.title}</h3><p>{h.text}</p></li>)}</ul>
</section>}
<CallOut heading={e.data.closing ?? 'I can host your event or stream the same way.'} links={[{ label: m?.cta ?? 'Book me for your event', href: '/speaking#book', icon: 'mail' }, ...(m?.project ? [{ label: 'See the full project', href: m.project }] : []), { label: 'All speaking', href: '/speaking' }]} />
</Base>
