---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import { SITE } from '../site';

---
<Base page="contact">
<Header current="Contact" />
<section style="padding: clamp(48px, 7vw, 104px) clamp(20px, 4.5vw, 64px) 110px; display: flex; flex-wrap: wrap; gap: 48px 64px">
<div style="flex: 1 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 24px; align-items: flex-start">
<h1 style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: clamp(44px, 7vw, 108px); line-height: 1.02; letter-spacing: -0.035em; ">Say hi.</h1>
<p style="margin: 0; max-width: 420px; font-size: 20px; color: #D5D8DB">Speaking, hosting, press, sponsorship, or go-to-market work with LFG. Pick what fits and tell me what you need.</p>
<a href="mailto:me@action.ceo" style="font-family: 'Montserrat', Arial, sans-serif; font-weight: 700; font-size: clamp(22px, 2.4vw, 30px); padding: 8px 0; border-bottom: 3px solid #69BE28">me@action.ceo</a>
<picture style="display: contents"><source type="image/avif" srcset="/img/studio-smile-800.avif 800w, /img/studio-smile-1156.avif 1156w" sizes="(max-width: 800px) 100vw, 1600px"><source type="image/webp" srcset="/img/studio-smile-800.webp 800w, /img/studio-smile-1156.webp 1156w" sizes="(max-width: 800px) 100vw, 1600px"><img src="/img/studio-smile.jpg" width="1156" height="650" loading="eager" fetchpriority="high" decoding="async" alt="Action smiling at his desk" style="width: 100%; max-width: 440px; aspect-ratio: 4 / 3; object-fit: cover; object-position: 45% 30%; margin-top: 16px"></picture>
</div>
<form data-form method="post" action="/api/contact" novalidate style="flex: 2 1 480px; min-width: 0; max-width: 720px; display: flex; flex-direction: column; gap: 20px">
<div style="display: flex; flex-direction: column; gap: 8px"><label for="c-type" style="font-weight: 600; font-size: 16px">What is this about?</label><select id="c-type" name="type" style="box-sizing: border-box; width: 100%; min-height: 52px; padding: 14px 16px; background: #0A2C52; border: 1px solid #A5AAAF; border-radius: 2px; color: #FFFFFF; font-family: 'Open Sans', Arial, sans-serif; font-size: 17px"><option>Speaking</option><option>Hosting or guest spot</option><option>LFG partnership</option><option>Sponsorship</option><option>Media</option><option>Other</option></select></div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 20px">
<div style="display: flex; flex-direction: column; gap: 8px"><label for="c-name" style="font-weight: 600; font-size: 16px">Your name</label><input id="c-name" name="name" type="text" required autocomplete="name" placeholder="" style="box-sizing: border-box; width: 100%; min-height: 52px; padding: 14px 16px; background: #0A2C52; border: 1px solid #A5AAAF; border-radius: 2px; color: #FFFFFF; font-family: 'Open Sans', Arial, sans-serif; font-size: 17px"></div><div style="display: flex; flex-direction: column; gap: 8px"><label for="c-email" style="font-weight: 600; font-size: 16px">Email</label><input id="c-email" name="email" type="email" required autocomplete="email" placeholder="" style="box-sizing: border-box; width: 100%; min-height: 52px; padding: 14px 16px; background: #0A2C52; border: 1px solid #A5AAAF; border-radius: 2px; color: #FFFFFF; font-family: 'Open Sans', Arial, sans-serif; font-size: 17px"></div>
</div>
<div style="display: flex; flex-direction: column; gap: 8px"><label for="c-org" style="font-weight: 600; font-size: 16px">Company or show (optional)</label><input id="c-org" name="org" type="text" placeholder="" style="box-sizing: border-box; width: 100%; min-height: 52px; padding: 14px 16px; background: #0A2C52; border: 1px solid #A5AAAF; border-radius: 2px; color: #FFFFFF; font-family: 'Open Sans', Arial, sans-serif; font-size: 17px"></div><div style="display: flex; flex-direction: column; gap: 8px"><label for="c-msg" style="font-weight: 600; font-size: 16px">Message</label><textarea id="c-msg" name="message" required rows="6" placeholder="" style="box-sizing: border-box; width: 100%; min-height: 52px; padding: 14px 16px; background: #0A2C52; border: 1px solid #A5AAAF; border-radius: 2px; color: #FFFFFF; font-family: 'Open Sans', Arial, sans-serif; font-size: 17px"></textarea></div>
<div style="display: flex; gap: 12px; align-items: flex-start"><input id="c-ok" name="consent" type="checkbox" required style="width: 22px; height: 22px; margin-top: 2px"><label for="c-ok" style="font-size: 16px; color: #D5D8DB">OK to email me back about this. See the <a href="/privacy" style="border-bottom: 1px solid #FFFFFF">privacy page</a>.</label></div>
<div class="cf-turnstile" data-sitekey={SITE.turnstileSiteKey} data-theme="dark"></div><input type="hidden" name="consent_version" value={SITE.consentVersion}><input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position: absolute; left: -9999px"><p data-form-status role="status" aria-live="polite" style="margin: 0; min-height: 26px; font-weight: 600"></p><button type="submit" style="align-self: flex-start; background: #69BE28; color: #06111F; border: 0; border-radius: 2px; cursor: pointer; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: 16px; padding: 16px 28px; min-height: 52px">Send message</button>
</form>
</section>
</Base>
