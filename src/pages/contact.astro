---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../site';

---
<Base page="contact">
<Header current="Contact" />
<PageHero img="studio-warm" big={1156} w={1156} h={650} alt="Action smiling at the camera in his studio" pos="50% 25%" posPhone="50% 20%">
<h1 style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: clamp(40px, 5.4vw, 80px); line-height: 0.98; letter-spacing: -0.035em">Don't be shy, <span style="white-space: nowrap">say hi.</span></h1>
<p style="margin: 0; max-width: 560px; font-size: 19px; color: #FFFFFF">Speaking, hosting, press, sponsorship or go-to-market work with LFG. Pick what fits and tell me what you&nbsp;need.</p>
<p style="margin: 0"><a href={`mailto:${SITE.email}`} class="ct-mail"><Icon name="mail" size={22} />{SITE.email}</a></p>
</PageHero>
<section class="ct-grid">
<div class="ct-side">
<h2 class="sec-h" style="margin-bottom: 28px">Pick what fits.</h2>
<ul role="list" class="ct-picks">
<li><button type="button" class="ct-pick" data-pick="Speaking" aria-pressed="false"><span class="ct-pick-h">Speaking</span><span class="ct-pick-d">Keynotes, panels and fireside chats on AI, DePIN, crypto and RWAs.</span></button></li>
<li><button type="button" class="ct-pick" data-pick="Hosting or guest spot" aria-pressed="false"><span class="ct-pick-h">Hosting</span><span class="ct-pick-d">Your stage, livestream, X Space or show. I guest on shows too.</span></button></li>
<li><button type="button" class="ct-pick" data-pick="Be a guest on my show" aria-pressed="false"><span class="ct-pick-h">Come on my show</span><span class="ct-pick-d">Founders and builders with something real to show.</span></button></li>
<li><button type="button" class="ct-pick" data-pick="LFG partnership" aria-pressed="false"><span class="ct-pick-h">Go-to-market with LFG</span><span class="ct-pick-d">Marketing, PR and launch work through Laissez-Faire Group.</span></button></li>
<li><button type="button" class="ct-pick" data-pick="Sponsorship" aria-pressed="false"><span class="ct-pick-h">Sponsorship</span><span class="ct-pick-d">Videos and live shows on Action Crypto and LFG Action.</span></button></li>
<li><button type="button" class="ct-pick" data-pick="Media" aria-pressed="false"><span class="ct-pick-h">Press</span><span class="ct-pick-d">Quotes, interviews and background on AI and crypto.</span></button></li>
</ul>
<p class="ct-note">Just want to argue about a video? The YouTube comments are open. <a href={SITE.youtube} rel="noopener" style="border-bottom: 1px solid #FFFFFF">Go to {SITE.channel}</a></p>
</div>
<form data-form method="post" action="/api/contact" novalidate class="ct-form">
<div style="display: flex; flex-direction: column; gap: 8px"><label for="c-type" style="font-weight: 600; font-size: 16px">What is this about?</label><select id="c-type" name="type" style="box-sizing: border-box; width: 100%; min-height: 52px; padding: 14px 16px; background: #0A2C52; border: 1px solid #A5AAAF; border-radius: 2px; color: #FFFFFF; font-family: 'Open Sans', Arial, sans-serif; font-size: 17px"><option>Speaking</option><option value="Hosting or guest spot">Book me to host, or to guest on your show</option><option value="Be a guest on my show">Be a guest on my show or podcast</option><option value="LFG partnership">LFG: go-to-market, marketing or PR</option><option>Sponsorship</option><option>Media</option><option>Other</option></select></div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 20px">
<div style="display: flex; flex-direction: column; gap: 8px"><label for="c-name" style="font-weight: 600; font-size: 16px">Your name</label><input id="c-name" name="name" type="text" required autocomplete="name" placeholder="" style="box-sizing: border-box; width: 100%; min-height: 52px; padding: 14px 16px; background: #0A2C52; border: 1px solid #A5AAAF; border-radius: 2px; color: #FFFFFF; font-family: 'Open Sans', Arial, sans-serif; font-size: 17px"></div><div style="display: flex; flex-direction: column; gap: 8px"><label for="c-email" style="font-weight: 600; font-size: 16px">Email</label><input id="c-email" name="email" type="email" required autocomplete="email" placeholder="" style="box-sizing: border-box; width: 100%; min-height: 52px; padding: 14px 16px; background: #0A2C52; border: 1px solid #A5AAAF; border-radius: 2px; color: #FFFFFF; font-family: 'Open Sans', Arial, sans-serif; font-size: 17px"></div>
</div>
<div style="display: flex; flex-direction: column; gap: 8px"><label for="c-org" style="font-weight: 600; font-size: 16px">Company or show (optional)</label><input id="c-org" name="org" type="text" placeholder="" style="box-sizing: border-box; width: 100%; min-height: 52px; padding: 14px 16px; background: #0A2C52; border: 1px solid #A5AAAF; border-radius: 2px; color: #FFFFFF; font-family: 'Open Sans', Arial, sans-serif; font-size: 17px"></div><div style="display: flex; flex-direction: column; gap: 8px"><label for="c-msg" style="font-weight: 600; font-size: 16px">What do you need?</label><textarea id="c-msg" name="message" required rows="6" placeholder="" style="box-sizing: border-box; width: 100%; min-height: 52px; padding: 14px 16px; background: #0A2C52; border: 1px solid #A5AAAF; border-radius: 2px; color: #FFFFFF; font-family: 'Open Sans', Arial, sans-serif; font-size: 17px"></textarea></div>
<div style="display: flex; gap: 12px; align-items: flex-start"><input id="c-ok" name="consent" type="checkbox" required style="width: 22px; height: 22px; margin-top: 2px"><label for="c-ok" style="font-size: 16px; color: #D5D8DB">OK to email me back about this. See the <a href="/privacy" style="border-bottom: 1px solid #FFFFFF">privacy page</a>.</label></div>
<div class="cf-turnstile" data-sitekey={SITE.turnstileSiteKey} data-theme="dark"></div><input type="hidden" name="consent_version" value={SITE.consentVersion}><input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position: absolute; left: -9999px"><p data-form-status role="status" aria-live="polite" style="margin: 0; min-height: 26px; font-weight: 600"></p><button type="submit" style="align-self: flex-start; background: #69BE28; color: #06111F; border: 0; border-radius: 2px; cursor: pointer; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: 16px; padding: 16px 28px; min-height: 52px">Send it</button>
</form>
</section>
</Base>
