---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../site';

---
<Base page="contact">
<Header current="Contact" />
<PageHero img="studio-warm" big={1156} w={1156} h={650} alt="Action smiling at the camera in his studio" pos="50% 25%" posPhone="50% 20%">
<h1 class="ct-h1">Don't be shy, <span class="nw">say hi.</span></h1>
<p class="hero-p">Speaking, hosting, press, sponsorship or go-to-market work with LFG. Pick what fits and tell me what you&nbsp;need.</p>
<p class="ct-mail-p"><a href={`mailto:${SITE.email}`} class="ct-mail"><Icon name="mail" size={22} />{SITE.email}</a></p>
</PageHero>
<section class="ct-grid">
<div class="ct-side">
<h2 class="sec-h ct-h2">Pick what fits.</h2>
<ul role="list" class="ct-picks">
<li><button type="button" class="ct-pick" data-pick="Speaking" aria-controls="c-type" disabled><span class="ct-pick-h">Speaking</span><span class="ct-pick-d">Talks, panels and fireside chats on AI, DePIN, crypto and RWAs.</span></button></li>
<li><button type="button" class="ct-pick" data-pick="Hosting or guest spot" aria-controls="c-type" disabled><span class="ct-pick-h">Hosting</span><span class="ct-pick-d">Your stage, livestream, X Space or show.</span></button></li>
<li><button type="button" class="ct-pick" data-pick="Be a guest on my show" aria-controls="c-type" disabled><span class="ct-pick-h">Come on my show</span><span class="ct-pick-d">Founder interviews on LFG Action. Bring something real to show.</span></button></li>
<li><button type="button" class="ct-pick" data-pick="LFG partnership" aria-controls="c-type" disabled><span class="ct-pick-h">Go-to-market with LFG</span><span class="ct-pick-d">Marketing, PR and launch work through Laissez-Faire Group.</span></button></li>
<li><button type="button" class="ct-pick" data-pick="Sponsorship" aria-controls="c-type" disabled><span class="ct-pick-h">Sponsorship</span><span class="ct-pick-d">Videos and live shows on Action Crypto and LFG Action.</span></button></li>
<li><button type="button" class="ct-pick" data-pick="Media" aria-controls="c-type" disabled><span class="ct-pick-h">Press</span><span class="ct-pick-d">Quotes, interviews and background on AI, DePIN and crypto.</span></button></li>
</ul>
<p class="ct-note">Just want to argue about a video? The YouTube comments are open. <a class="uline" href={SITE.youtube} rel="noopener">Go to {SITE.channel}</a></p>
</div>
<form data-form method="post" action="/api/contact" novalidate class="ct-form">
<div class="stack"><label class="field-l" for="c-type">What is this about?</label><select class="field" id="c-type" name="type"><option>Speaking</option><option value="Hosting or guest spot">Book me to host, or to guest on your show</option><option value="Be a guest on my show">Be a guest on my show or podcast</option><option value="LFG partnership">LFG: go-to-market, marketing or PR</option><option>Sponsorship</option><option>Media</option><option>Other</option></select></div>
<div class="form-grid">
<div class="stack"><label class="field-l" for="c-name">Your name</label><input class="field" id="c-name" name="name" type="text" required autocomplete="name" placeholder=""></div><div class="stack"><label class="field-l" for="c-email">Email</label><input class="field" id="c-email" name="email" type="email" required autocomplete="email" placeholder=""></div>
</div>
<div class="stack"><label class="field-l" for="c-org">Company or show (optional)</label><input class="field" id="c-org" name="org" type="text" placeholder=""></div><div class="stack"><label class="field-l" for="c-msg">What do you need?</label><textarea class="field" id="c-msg" name="message" required rows="6" placeholder=""></textarea></div>
<div class="check-row"><input class="check" id="c-ok" name="consent" type="checkbox" required><label class="check-l" for="c-ok">OK to email me back about this. See the <a class="uline" href="/privacy">terms and privacy page</a>.</label></div>
<div class="cf-turnstile" data-sitekey={SITE.turnstileSiteKey} data-theme="dark"></div><input type="hidden" name="consent_version" value={SITE.consentVersion}><input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true"><p class="form-status" data-form-status role="status" aria-live="polite"></p><button class="btn-send" type="submit">Send it</button>
</form>
</section>
</Base>
