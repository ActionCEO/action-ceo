---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import PageHero from '../../components/PageHero.astro';
import CallOut from '../../components/CallOut.astro';
import { getCollection } from 'astro:content';
import VideoCard from '../../components/VideoCard.astro';
const streams = (await getCollection('videos')).filter((v) => v.data.series === 'depin-day').sort((a, b) => +a.data.publishedAt - +b.data.publishedAt);
// Rule from Action: no AI-made picture sits next to footage of the real event. The only event pictures
// below the header are the livestream thumbnails.
const facts = [
  ['Role', 'Co-organizer and host'],
  ['Years', '2024 and 2025'],
  ['On stage', 'T-Mobile, HP, Borderless Capital (across 2024 and 2025)'],
  ['Livestream', '65,000+ viewers on X'],
];
---
<Base page="project">
<Header current="Work" />
<PageHero img="depin-wide" big={1456} w={1456} h={813} alt="Action on stage at DePIN Day: Seattle in front of the big screen" pos="31% 30%" posPhone="31% 20%">
<a href="/work" class="hero-back">« All work</a>
<h1 class="hero-h1">DePIN Day: Seattle</h1>
<p class="hero-p">2 years, 2 full days of DePIN on 1 stage. I co-organized it with the team behind it and hosted it both years.</p>
</PageHero>
<section class="rv pad sec" aria-label="Overview">
<dl class="facts">{facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
</section>
<section class="rv pad" aria-labelledby="streams-h" style="padding-bottom: 96px">
<h2 class="sec-h" id="streams-h">Watch the full livestreams</h2>
<div class="vgrid vgrid-2">{streams.map((v) => <VideoCard video={v} />)}</div>
</section>
<CallOut heading="I can host your event the same way, or help build it." links={[{ label: 'Book me to host', href: '/speaking#book', icon: 'mail' }, { label: 'Next: Action Items', href: '/shows/action-items' }, { label: 'All work', href: '/work' }]} />
</Base>
