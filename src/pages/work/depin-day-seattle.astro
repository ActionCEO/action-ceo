---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { SITE } from '../../site';

---
<Base page="project">
<Header current="Work" />
<header style="padding: clamp(40px, 6vw, 88px) clamp(20px, 4.5vw, 64px) 48px; display: flex; flex-direction: column; gap: 20px">
<a href="/work" style="align-self: flex-start; padding: 10px 0; color: #D5D8DB">Back to all work</a>
<h1 style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-weight: 900; font-size: clamp(44px, 9vw, 140px); text-transform: uppercase; line-height: 0.9; letter-spacing: -0.045em">DePIN Day: Seattle</h1>
</header>
<div style="overflow: clip">
<picture style="display: contents"><source type="image/avif" srcset="/img/depin-stage-800.avif 800w, /img/depin-stage-1446.avif 1446w" sizes="(max-width: 800px) 100vw, 1600px"><source type="image/webp" srcset="/img/depin-stage-800.webp 800w, /img/depin-stage-1446.webp 1446w" sizes="(max-width: 800px) 100vw, 1600px"><img src="/img/depin-stage.jpg" width="1446" height="819" loading="eager" fetchpriority="high" decoding="async" class="zi"  alt="The DePIN Day: Seattle stage seen from the back of the room, Action alone on stage" style="display: block; width: 100%; height: clamp(320px, 46vw, 680px); object-fit: cover"></picture>
</div>
<section class="rv" aria-label="Overview" style="padding: 96px clamp(20px, 4.5vw, 64px); display: flex; flex-wrap: wrap; gap: 40px 64px">
<dl style="margin: 0; flex: 1 1 240px; display: flex; flex-direction: column; gap: 24px">
<div style="display: flex; flex-direction: column; gap: 4px"><dt style="font-size: 16px; color: #A5AAAF">Role</dt><dd style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-weight: 700; font-size: 19px">Creator, producer, host</dd></div><div style="display: flex; flex-direction: column; gap: 4px"><dt style="font-size: 16px; color: #A5AAAF">Years</dt><dd style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-weight: 700; font-size: 19px">2024 and 2025</dd></div><div style="display: flex; flex-direction: column; gap: 4px"><dt style="font-size: 16px; color: #A5AAAF">On stage</dt><dd style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-weight: 700; font-size: 19px">T-Mobile, HP, Borderless Capital</dd></div><div style="display: flex; flex-direction: column; gap: 4px"><dt style="font-size: 16px; color: #A5AAAF">Livestream</dt><dd style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-weight: 700; font-size: 19px">65,000+ viewers on X</dd></div>
</dl>
<div style="flex: 3 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 24px">
<p style="margin: 0; max-width: 820px; font-family: 'Montserrat', Arial, sans-serif; font-weight: 700; font-size: clamp(24px, 3vw, 40px); line-height: 1.15; letter-spacing: -0.025em">I created, produced and hosted DePIN Day: Seattle in 2024 and 2025.</p>
<p style="margin: 0; max-width: 680px; font-size: 19px; color: #D5D8DB">T-Mobile, HP and Borderless Capital were on stage. 65,000+ viewers on the X livestream.</p>
<p style="margin: 0; max-width: 680px; font-size: 16px; color: #A5AAAF">[ADD: WHY YOU STARTED DEPIN DAY AND HOW IT CAME TOGETHER, IN YOUR WORDS]</p>
</div>
</section>
<section class="rv" aria-label="Coverage figure" style="padding: 0 clamp(20px, 4.5vw, 64px) 96px">
<iframe src="/figures/coverage.html?theme=dark" title="Coverage: an interactive line drawing of a DePIN network. Move the pointer over it." loading="lazy" width="1200" height="640" style="display: block; width: 100%; height: clamp(420px, 56vw, 640px); border: 1px solid #0A2C52; border-radius: 4px; background: #06111F"></iframe>
</section>
<section class="rv" aria-label="Photos" style="padding: 0 clamp(20px, 4.5vw, 64px) 96px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr)); gap: 24px">
<picture style="display: contents"><source type="image/avif" srcset="/img/depin-panel-800.avif 800w, /img/depin-panel-1446.avif 1446w" sizes="(max-width: 800px) 100vw, 1600px"><source type="image/webp" srcset="/img/depin-panel-800.webp 800w, /img/depin-panel-1446.webp 1446w" sizes="(max-width: 800px) 100vw, 1600px"><img src="/img/depin-panel.jpg" width="1446" height="819" loading="lazy" decoding="async" alt="Action standing with a mic next to seated panelists at DePIN Day: Seattle" style="display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover"></picture>
<div style="aspect-ratio: 4 / 3; box-sizing: border-box; border: 1px dashed #A5AAAF; display: flex; align-items: center; justify-content: center; padding: 16px; text-align: center; font-family: 'Montserrat', Arial, sans-serif; font-weight: 700; font-size: 13px; letter-spacing: 0.08em; color: #D5D8DB; ">[PHOTO NEEDED: CROWD OR SPONSOR WALL]</div>
</section>
<section class="rv" aria-label="Watch" style="padding: 0 clamp(20px, 4.5vw, 64px) 110px; display: flex; flex-direction: column; gap: 20px">
<h2 style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: clamp(28px, 3.2vw, 44px); line-height: 1.02; letter-spacing: -0.035em; ">Watch it back</h2>
<div style="aspect-ratio: 16 / 9; box-sizing: border-box; border: 1px dashed #A5AAAF; display: flex; align-items: center; justify-content: center; padding: 16px; text-align: center; font-family: 'Montserrat', Arial, sans-serif; font-weight: 700; font-size: 13px; letter-spacing: 0.08em; color: #D5D8DB; max-width: 1100px">[DEPIN DAY REPLAY: CLICK-TO-PLAY THUMBNAIL, VIDEO LINK NEEDED]</div>
</section>
<section class="rv" aria-label="Next project" style="border-top: 1px solid #0A2C52; padding: 72px clamp(20px, 4.5vw, 64px); display: flex; flex-direction: column; gap: 8px; align-items: flex-start">
<span style="color: #A5AAAF">Next</span>
<a href="/shows" style="font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: clamp(32px, 5vw, 72px); letter-spacing: -0.035em; border-bottom: 3px solid #69BE28">Action Items</a>
</section>
</Base>
