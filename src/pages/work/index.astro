---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { SITE } from '../../site';
import Icon from '../../components/Icon.astro';
import CallOut from '../../components/CallOut.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';
// Each row has 1 preview: it fills the panel on the right on desktop and sits under the row on phones.
// pos keeps Action in frame when a wide photo is cropped to the tall panel (object-position).
// Action Items shows the newest episode's own thumbnail, so it never looks like the Action Crypto row.
const latestShow = (await getCollection('videos')).filter((v) => v.data.series === 'action-items').sort((a, b) => +b.data.publishedAt - +a.data.publishedAt)[0];
const showThumb = latestShow ? `https://i.ytimg.com/vi/${latestShow.data.youtubeId}/hq720.jpg` : '/img/studio-live-800.webp';
const work = [
  { name: SITE.channel, role: 'My main channel. My takes on AI, DePIN and crypto since 2021', cta: 'Watch on YouTube', href: SITE.youtube, yt: true, img: 'portrait', w: 1324, h: 1580, big: 1324, pos: '50% 30%', thumbPos: '50% 12%', alt: `Action at the mic on ${SITE.channel}` },
  { name: 'DePIN Day: Seattle', role: 'Co-organizer and host. 2024 and 2025', cta: 'See the event', href: '/work/depin-day-seattle', img: 'depin-stage', w: 1456, h: 721, big: 1456, pos: '50% 10%', alt: 'Action speaking on the DePIN Day: Seattle stage' },
  { name: 'Action Items', role: 'My weekly live show. Fridays, 9:30am Pacific', cta: 'See the show', href: '/shows/action-items', yt: true, kind: 'show' },
  { name: 'Laissez-Faire Group', role: 'Partner and CCO: go-to-market, marketing and communications', cta: 'Work with LFG', href: '/lfg', img: 'stage-keynote', w: 1456, h: 813, big: 1456, pos: '27% 50%', alt: 'Action on a conference stage holding a microphone' },
  { name: 'Karate Combat', role: 'Livestream host, 2024 to 2025', cta: 'See the role', href: '/speaking/karate-combat', img: 'kc-pitside', w: 1456, h: 813, big: 1456, pos: '74% 50%', alt: 'Action commentating pitside at a Karate Combat event' },
  { name: 'Genzio', role: 'Host of the Genzio Roundtable. Live programming lead since 2022', cta: 'See the show', href: '/shows/genzio-roundtable', kind: 'genzio' },
].map((r, i) => ({ ...r, num: '0' + (i + 1) }));
const DO = ['Hosting', 'Speaking', 'Video', 'Live shows', 'Marketing', 'PR', 'Go-to-market', 'Partnerships'];
---
<Base page="work">
<Header current="Work" />
<PageHero img="depin-panel" big={1446} w={1446} h={819} alt="Action hosting a panel on the DePIN Day: Seattle stage" pos="60% 40%" posPhone="100% 40%">
<h1 style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: clamp(44px, 7vw, 108px); line-height: 1.02; letter-spacing: -0.035em">Work.</h1>
<p class="one-line" style="margin: 0; font-size: 20px; color: #FFFFFF">Channels I run, shows I host, events I co-organized, and the firm where I'm a Partner.</p>
</PageHero>
<section class="rv" aria-label="Projects" style="padding: clamp(40px, 5vw, 72px) clamp(20px, 4.5vw, 64px) 120px; display: flex; flex-wrap: wrap; gap: 40px 64px; align-items: flex-start">
<div class="rows" data-pv-rows style="flex: 3 1 480px; min-width: 0; display: flex; flex-direction: column">
{work.map((item, i) => (
<a href={item.href} data-pv={i} class:list={['pvrow', { on: i === 0 }]}>
<span style="font-family: 'Montserrat', Arial, sans-serif; font-weight: 700; font-size: 16px; color: #A5AAAF; font-variant-numeric: tabular-nums">{item.num}</span>
<span style="display: flex; flex-direction: column; gap: 6px; min-width: 0; flex: 1">
<span style="font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: clamp(28px, 4.2vw, 60px); line-height: 1.02; letter-spacing: -0.035em">{item.name}</span>
<span style="font-size: 17px; color: #A5AAAF">{item.role}</span>
<span style="display: inline-flex; align-items: center; gap: 8px; font-size: 16px; font-weight: 600; color: #D5D8DB">{item.yt && <Icon name="youtube" size={22} />}{item.cta}{item.href.startsWith('http') ? <Icon name="out" size={16} label="opens in a new tab" /> : <Icon name="go" size={16} />}</span>
{item.kind === 'genzio' ? <span class="row-thumb pv-genzio" style="align-items: center; justify-content: center"><img src="/img/genzio-logo-white.png" alt="" width="500" height="159" loading="lazy" decoding="async" style="width: 56%; height: auto"></span>
  : <img class="row-thumb" src={item.kind === 'show' ? showThumb : `/img/${item.img}-800.webp`} alt="" width="800" height="450" loading="lazy" decoding="async" data-fallback={item.kind === 'show' ? '/img/studio-live-800.webp' : undefined} style={item.pos ? `object-position: ${item.thumbPos ?? item.pos}` : undefined}>}
</span>
</a>
))}
</div>
<div class="pvpanel" aria-hidden="true">
<button type="button" class="pv-pause" data-pv-pause hidden tabindex="-1">Pause</button>
{work.map((item, i) => item.kind === 'genzio' ? (
<div data-pv-img={i} class="pv pv-genzio" style={`opacity: ${i === 0 ? 1 : 0}`}><img src="/img/genzio-logo-white.png" width="500" height="159" alt="Genzio logo" loading="lazy" decoding="async" style="width: 60%; height: auto"></div>
) : item.kind === 'show' ? (
<div data-pv-img={i} class="pv pv-show" style={`opacity: ${i === 0 ? 1 : 0}`}>
<img src={showThumb} data-fallback="/img/studio-live-800.webp" width="1280" height="720" alt={latestShow ? `Latest Action Items episode: ${latestShow.data.title}` : 'Action live in his studio'} loading="lazy" decoding="async">
<span class="pv-live"><i aria-hidden="true"></i>Live Fridays, 9:30am Pacific</span>
</div>
) : (
<picture style="display: contents"><source type="image/avif" srcset={`/img/${item.img}-800.avif 800w, /img/${item.img}-${item.big}.avif ${item.big}w`} sizes="40vw"><source type="image/webp" srcset={`/img/${item.img}-800.webp 800w, /img/${item.img}-${item.big}.webp ${item.big}w`} sizes="40vw"><img src={`/img/${item.img}.jpg`} width={item.w} height={item.h} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" data-pv-img={i} class="pv" alt={item.alt} style={`position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: ${item.pos}; opacity: ${i === 0 ? 1 : 0}`}></picture>
))}
</div>
</section>
<CallOut heading="I host shows and events, make videos, and run marketing, PR and go-to-market for teams in AI, DePIN and crypto." links={[{ label: 'Get in touch', href: '/contact', icon: 'mail' }]}>
<ul class="tags" aria-label="What I do">{DO.map((d) => <li>{d}</li>)}</ul>
<p style="margin: 0; font-size: 20px; color: #D5D8DB">Tell me what you need and I'll tell you if I'm the right fit.</p>
</CallOut>
</Base>
