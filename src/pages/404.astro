---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import { SITE } from '../site';

---
<Base page="notfound" noindex>
<Header current="" />
<section style="position: relative; min-height: 720px; display: flex; flex-direction: column; justify-content: center; overflow: hidden">
<div aria-hidden="true" style="position: absolute; right: -2vw; bottom: -6vw; font-family: 'Montserrat', Arial, sans-serif; font-weight: 900; font-size: clamp(200px, 38vw, 560px); line-height: 0.8; letter-spacing: -0.06em; color: #0A2C52">404</div>
<div style="position: relative; padding: 72px clamp(20px, 4.5vw, 64px); display: flex; flex-direction: column; gap: 24px; align-items: flex-start">
<h1 style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: clamp(44px, 7vw, 108px); line-height: 1.02; letter-spacing: -0.035em; ">No action here.</h1>
<p style="margin: 0; max-width: 520px; font-size: 20px; color: #D5D8DB">That page moved or never existed. Try 1 of these.</p>
<div style="display: flex; flex-wrap: wrap; gap: 8px 32px"><a href="/" style="font-weight: 600; padding: 10px 0; border-bottom: 3px solid #69BE28">Go home</a><a href="/blog" style="font-weight: 600; padding: 10px 0; border-bottom: 1px solid #FFFFFF">Latest breakdowns</a><a href="https://www.youtube.com/@ActionCrypto" rel="noopener" style="font-weight: 600; padding: 10px 0; border-bottom: 1px solid #FFFFFF">Watch on YouTube</a><a href="/shows" style="font-weight: 600; padding: 10px 0; border-bottom: 1px solid #FFFFFF">Shows</a></div>
</div>
</section>
</Base>
