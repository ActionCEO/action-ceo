---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { SITE } from '../../site';
import Icon from '../../components/Icon.astro';
import LiveBar from '../../components/LiveBar.astro';
import CallOut from '../../components/CallOut.astro';
import PageHero from '../../components/PageHero.astro';

---
<Base page="shows">
<Header current="Shows" />
<PageHero img="studio-live" big={1156} w={1156} h={650} alt="Action live at the mic in his studio" pos="50% 25%" posPhone="50% 20%">
<h1 class="legal-h1">Shows.</h1>
<p class="shows-lead">Here's when I'm on and where to watch.</p>
</PageHero>
<div class="pad livebar-wrap"><LiveBar cta="subscribe" /></div>
<section class="show-list" aria-label="Schedule">
<article class="rv show-row">
<div class="show-when">
<div class="show-day">Fridays</div>
<div class="show-time">9:30am Pacific</div>
</div>
<div class="show-text">
<h2 class="show-h"><a href="/shows/action-items">Action Items</a></h2>
<p class="show-p">My weekly live show. No edits, no retakes. On YouTube, LinkedIn and X (@LFGAction) at the same time.</p>
<div class="links2"><a href="/shows/action-items" class="go ulink">Past episodes</a><a href={`${SITE.youtube}/live`} rel="noopener" title={`${SITE.channel} live on YouTube`} class="ext ulink ulink-i"><Icon name="youtube" size={20} />YouTube<span class="sr">, opens in a new tab</span></a><a href={SITE.linkedin} rel="noopener" title="Action on LinkedIn" class="ext ulink ulink-i"><Icon name="linkedin" size={18} />LinkedIn<span class="sr">, opens in a new tab</span></a><a href={SITE.xLfg} rel="noopener" title="@LFGAction on X" class="ext ulink ulink-i"><Icon name="x" size={18} label="X" />@LFGAction<span class="sr">, opens in a new tab</span></a></div>
</div>
<picture class="pic"><source type="image/avif" srcset="/img/studio-live-800.avif 800w, /img/studio-live-1156.avif 1156w" sizes="(max-width: 800px) 100vw, 1600px"><source type="image/webp" srcset="/img/studio-live-800.webp 800w, /img/studio-live-1156.webp 1156w" sizes="(max-width: 800px) 100vw, 1600px"><img src="/img/studio-live.jpg" width="1156" height="650" loading="eager" fetchpriority="high" decoding="async" alt="Action live at the mic in his studio" class="show-media"></picture>
</article>
<article class="rv show-row">
<div class="show-when">
<div class="show-day">X Spaces</div>
<div class="show-time">Voice only</div>
</div>
<div class="show-text">
<h2 class="show-h"><a href="/shows/genzio-roundtable">Genzio Roundtable</a></h2>
<p class="show-p">No cameras, just voices. I host it, and I've hosted Genzio's live shows since 2022.</p>
<a href="/shows/genzio-roundtable" class="go ulink">See the show</a>
</div>
<div class="show-media genzio-bg show-logo-panel"><img class="logo-58" src="/img/genzio-logo-white.png" width="500" height="159" alt="Genzio logo" loading="lazy"></div>
</article>
<article class="rv show-row">
<div class="show-when">
<div class="show-day">LFG Action</div>
<div class="show-time">On YouTube</div>
</div>
<div class="show-text">
<h2 class="show-h"><a href="/shows/interviews">Founder interviews</a></h2>
<p class="show-p">I interview founders, builders and researchers. The DeAI Podcast, my series on who controls AI, lives here too.</p>
<div class="links-row"><a href="/shows/interviews" class="go ulink">See the interviews</a></div>
</div>
<picture class="pic"><source type="image/avif" srcset="/img/studio-interview-800.avif 800w, /img/studio-interview-1156.avif 1156w" sizes="(max-width: 800px) 100vw, 1600px"><source type="image/webp" srcset="/img/studio-interview-800.webp 800w, /img/studio-interview-1156.webp 1156w" sizes="(max-width: 800px) 100vw, 1600px"><img src="/img/studio-interview.jpg" width="1156" height="650" loading="lazy" decoding="async" alt="Action listening to a guest during an interview" class="show-media"></picture>
</article>
</section>
<section class="rv channels" aria-label="Channels">
<div class="channel">
<h2 class="channel-h">{SITE.channel}</h2>
<p class="para">My main channel. AI, DePIN and crypto, with opinions. 1.6M+ views, 20.7K subscribers.</p>
<a href={`${SITE.youtube}?sub_confirmation=1`} rel="noopener" title={`Subscribe to ${SITE.channel} on YouTube`} class="btn-line ext"><Icon name="youtube" size={22} />Subscribe to {SITE.channel}<span class="sr">, opens in a new tab</span></a>
</div>
<div class="channel channel-2">
<h2 class="channel-h">LFG Action</h2>
<p class="para">The interview channel. LFG stands for <a class="uline" href="/lfg">Laissez-Faire Group</a>, where I'm a Partner.</p>
<a href={`${SITE.youtubeLfg}?sub_confirmation=1`} rel="noopener" title="Subscribe to LFG Action on YouTube" class="btn-line ext"><Icon name="youtube" size={22} />Subscribe to LFG Action<span class="sr">, opens in a new tab</span></a>
</div>
</section>
<CallOut heading="I host other people's shows and livestreams too." links={[{ label: 'Book me to host', href: '/speaking#book', icon: 'mail' }]} />
</Base>
