---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { SITE } from '../../site';

---
<Base page="shows">
<Header current="Shows" />
<header style="padding: clamp(48px, 7vw, 104px) clamp(20px, 4.5vw, 64px) 56px; display: flex; flex-direction: column; gap: 24px">
<h1 style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: clamp(44px, 7vw, 108px); line-height: 0.95; letter-spacing: -0.04em">On air.</h1>
<p style="margin: 0; max-width: 620px; font-size: 20px; color: #D5D8DB">Here's when I'm on and where to watch.</p>
<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 10px 28px; padding: 18px 0; border-top: 1px solid #0A2C52; border-bottom: 1px solid #0A2C52; font-size: 17px">
<span class="air-dot" aria-hidden="true" style="width: 10px; height: 10px; border-radius: 50%; background: #69BE28; animation: airpulse 1.6s ease-in-out infinite"></span>
<span style="font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; letter-spacing: 0.04em">NEXT LIVE SHOW</span>
<span style="font-family: 'Montserrat', Arial, sans-serif; font-weight: 700; font-variant-numeric: tabular-nums"><span data-countdown="Action Items in ">Action Items, Friday 9:30am Pacific</span></span>
<a href="https://www.youtube.com/@ActionCrypto" rel="noopener" style="margin-left: auto; background: #69BE28; color: #06111F; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: 16px; padding: 14px 22px; border-radius: 2px">Subscribe and catch it live</a>
</div>
</header>
<section aria-label="Schedule" style="padding: 0 clamp(20px, 4.5vw, 64px) 96px">
<article class="rv" style="display: flex; flex-wrap: wrap; gap: 24px 48px; padding: 44px 0; border-top: 1px solid #0A2C52">
<div style="flex: 1 1 180px; display: flex; flex-direction: column; gap: 6px">
<div style="display: flex; align-items: center; gap: 10px; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: 22px">Fridays</div>
<div style="font-family: 'Montserrat', Arial, sans-serif; font-weight: 700; font-size: 18px; color: #D5D8DB; font-variant-numeric: tabular-nums">9:30am Pacific</div>
</div>
<div style="flex: 3 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 14px; align-items: flex-start">
<h2 style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: clamp(30px, 4vw, 56px); line-height: 1; letter-spacing: -0.035em"><a href="/shows/action-items">Action Items</a></h2>
<p style="margin: 0; max-width: 560px; font-size: 19px; color: #D5D8DB">My weekly live show. No edits, no retakes. On YouTube, LinkedIn and X at the same time.</p>
<div style="display: flex; flex-wrap: wrap; gap: 4px 24px"><a href="https://www.youtube.com/@ActionCrypto" rel="noopener" style="font-weight: 600; padding: 10px 0; border-bottom: 1px solid #FFFFFF">YouTube</a><a href="https://www.linkedin.com/in/vic-action-crypto" rel="noopener" style="font-weight: 600; padding: 10px 0; border-bottom: 1px solid #FFFFFF">LinkedIn</a><a href="https://x.com/ActionCEO" rel="noopener" style="font-weight: 600; padding: 10px 0; border-bottom: 1px solid #FFFFFF">X</a></div>
</div>
<picture style="display: contents"><source type="image/avif" srcset="/img/studio-live-800.avif 800w, /img/studio-live-1156.avif 1156w" sizes="(max-width: 800px) 100vw, 1600px"><source type="image/webp" srcset="/img/studio-live-800.webp 800w, /img/studio-live-1156.webp 1156w" sizes="(max-width: 800px) 100vw, 1600px"><img src="/img/studio-live.jpg" width="1156" height="650" loading="eager" fetchpriority="high" decoding="async" alt="Action live at the mic in his studio" style="flex: 1 1 260px; min-width: 0; width: 100%; max-width: 420px; aspect-ratio: 16 / 9; object-fit: cover"></picture>
</article>
<article class="rv" style="display: flex; flex-wrap: wrap; gap: 24px 48px; padding: 44px 0; border-top: 1px solid #0A2C52">
<div style="flex: 1 1 180px; display: flex; flex-direction: column; gap: 6px">
<div style="display: flex; align-items: center; gap: 10px; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: 22px">X Spaces</div>
<div style="font-family: 'Montserrat', Arial, sans-serif; font-weight: 700; font-size: 18px; color: #D5D8DB; font-variant-numeric: tabular-nums">Voice only</div>
</div>
<div style="flex: 3 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 14px; align-items: flex-start">
<h2 style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: clamp(30px, 4vw, 56px); line-height: 1; letter-spacing: -0.035em"><a href="/shows/genzio-roundtable">Genzio Roundtable</a></h2>
<p style="margin: 0; max-width: 560px; font-size: 19px; color: #D5D8DB">No cameras, just voices. I host it, and I've led live programming at Genzio since 2022.</p>
</div>
</article>
<article class="rv" style="display: flex; flex-wrap: wrap; gap: 24px 48px; padding: 44px 0; border-top: 1px solid #0A2C52">
<div style="flex: 1 1 180px; display: flex; flex-direction: column; gap: 6px">
<div style="display: flex; align-items: center; gap: 10px; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: 22px">LFG Action</div>
<div style="font-family: 'Montserrat', Arial, sans-serif; font-weight: 700; font-size: 18px; color: #D5D8DB; font-variant-numeric: tabular-nums">On YouTube</div>
</div>
<div style="flex: 3 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 14px; align-items: flex-start">
<h2 style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: clamp(30px, 4vw, 56px); line-height: 1; letter-spacing: -0.035em"><a href="/shows/interviews">Founder interviews</a></h2>
<p style="margin: 0; max-width: 560px; font-size: 19px; color: #D5D8DB">I interview founders and builders about what they're building. My DeAI Summit interviews are here too.</p>
<div style="display: flex; flex-wrap: wrap; gap: 4px 24px"><a href="https://www.youtube.com/@LFGAction" rel="noopener" style="font-weight: 600; padding: 10px 0; border-bottom: 1px solid #FFFFFF">Watch the interviews</a></div>
</div>
<picture style="display: contents"><source type="image/avif" srcset="/img/studio-interview-800.avif 800w, /img/studio-interview-1156.avif 1156w" sizes="(max-width: 800px) 100vw, 1600px"><source type="image/webp" srcset="/img/studio-interview-800.webp 800w, /img/studio-interview-1156.webp 1156w" sizes="(max-width: 800px) 100vw, 1600px"><img src="/img/studio-interview.jpg" width="1156" height="650" loading="lazy" decoding="async" alt="Action listening to a guest during an interview" style="flex: 1 1 260px; min-width: 0; width: 100%; max-width: 420px; aspect-ratio: 16 / 9; object-fit: cover"></picture>
</article>
</section>
<section class="rv" aria-label="Channels" style="padding: 0 clamp(20px, 4.5vw, 64px) 110px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr)); gap: 40px 64px">
<div style="display: flex; flex-direction: column; gap: 12px; align-items: flex-start; border-top: 3px solid #FFFFFF; padding-top: 24px">
<h2 style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: 30px; letter-spacing: -0.02em">Action Crypto</h2>
<p style="margin: 0; color: #D5D8DB; font-size: 19px">My main channel. AI, DePIN and crypto, with opinions. 1.6M+ views, 20.7K subscribers.</p>
<a href="https://www.youtube.com/@ActionCrypto" rel="noopener" style="font-weight: 600; padding: 10px 0; border-bottom: 1px solid #FFFFFF">Subscribe to Action Crypto</a>
</div>
<div style="display: flex; flex-direction: column; gap: 12px; align-items: flex-start; border-top: 3px solid #326496; padding-top: 24px">
<h2 style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: 30px; letter-spacing: -0.02em">LFG Action</h2>
<p style="margin: 0; color: #D5D8DB; font-size: 19px">The interview channel. LFG stands for <a href="/lfg" style="border-bottom: 1px solid #FFFFFF">Laissez-Faire Group</a>, where I'm a Partner.</p>
<a href="https://www.youtube.com/@LFGAction" rel="noopener" style="font-weight: 600; padding: 10px 0; border-bottom: 1px solid #FFFFFF">Subscribe to LFG Action</a>
</div>
</section>
<section class="rv" id="talk" style="background: #002346; padding: 110px clamp(20px, 4.5vw, 64px); display: flex; flex-direction: column; gap: 28px">
<h2 style="margin: 0; max-width: 1000px; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: clamp(34px, 4.8vw, 68px); line-height: 1; letter-spacing: -0.035em">I host other people's shows and livestreams too.</h2>
<a href="/speaking#book" style="align-self: flex-start; font-family: 'Montserrat', Arial, sans-serif; font-weight: 700; font-size: clamp(22px, 2.4vw, 32px); padding: 8px 0; border-bottom: 3px solid #69BE28">Book me to host</a>
</section>
</Base>
