---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import { SITE } from '../site';
import LatestVideo from '../components/LatestVideo.astro';
import TelegramNote from '../components/TelegramNote.astro';
import Icon from '../components/Icon.astro';
import LiveBar from '../components/LiveBar.astro';
import CallOut from '../components/CallOut.astro';
// Each row gets a small mark: a logo file from public/img, the YouTube icon, or 2 letters until a logo file arrives.
const work = [
  { name: SITE.channel, role: 'My main channel. My takes on AI, DePIN and crypto since 2021', href: SITE.youtube, yt: true },
  { name: 'DePIN Day: Seattle', role: 'Co-organizer and host. 2024 and 2025', href: '/work/depin-day-seattle', logo: '/img/depin-mark.png' },
  { name: 'Action Items', role: 'My weekly live show, on YouTube, LinkedIn and X', href: '/shows/action-items', logo: '/img/icon-512.png', live: true },
  { name: 'Laissez-Faire Group', role: 'My day job. Partner and CCO: go-to-market, marketing and PR', href: '/lfg', logo: '/img/lfg-mark.png', wide: true },
  { name: 'Hedera', role: 'Host of its community livestreams, 2025', href: '/speaking/hedera-livestreams', mono: 'H' },
  { name: 'Karate Combat', role: 'Livestream host, 2024 to 2025', href: '/speaking/karate-combat', logo: '/img/kc-mark.png' },
  { name: 'Genzio', role: 'Host of the Genzio Roundtable and its live shows since 2022', href: '/shows/genzio-roundtable', logo: '/img/genzio-mark.png' },
];
import fs from 'node:fs';
import { getCollection } from 'astro:content';
// Hero button goes to the newest video, same pick as the latest video block. Falls back to the channel's video list.
import { livePosts } from '../lib/content';
// Hero button: the newest post (video plus write-up). Falls back to the newest video on YouTube, then the channel.
const newestPost = (await livePosts())[0];
const newest = (await getCollection('videos')).filter((v) => v.data.channel === 'ActionCrypto' && !v.id.startsWith('SAMPLE')).sort((a, b) => +b.data.publishedAt - +a.data.publishedAt)[0];
const watchHref = newestPost ? `/blog/${newestPost.id}` : newest ? `https://www.youtube.com/watch?v=${newest.data.youtubeId}` : `${SITE.youtube}/videos`;
// Optional hero background video: drop the file at public/video/hero-stage.mp4 and it switches on.
const heroVideo = fs.existsSync('public/video/hero-stage.mp4');
---
<Base page="home" overlay>
<header class="home-hero">
<picture class="pic"><source type="image/avif" srcset="/img/studio-hero-800.avif 800w, /img/studio-hero-1920.avif 1920w" sizes="(max-width: 800px) 100vw, 1600px"><source type="image/webp" srcset="/img/studio-hero-800.webp 800w, /img/studio-hero-1920.webp 1920w" sizes="(max-width: 800px) 100vw, 1600px"><img src="/img/studio-hero.jpg" width="1920" height="1080" loading="eager" fetchpriority="high" decoding="async" class="hero-img hero-flip fill" alt="Action smiling at the camera in his studio, guitars on the wall behind him"></picture>
{heroVideo && <video class="fill hero-video" data-hero-video data-src="/video/hero-stage.mp4" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>}
<div aria-hidden="true" class="hero-shade"></div>
<div aria-hidden="true" class="hero-side"></div>

<Header current="" />

<div class="px hero-text">
<h1 class="home-h1">I ran the company.<br>Now I break it down.</h1>
<div class="hero-row">
<p class="home-lead">I'm Action. I spent 6 years as a COO, doing the talking and the negotiating. Now I explain AI, DePIN and crypto in plain English on my channel, {SITE.channel}.</p>
<a class="hero-btn" href={watchHref}>Watch the latest breakdown</a>
<a class="ulink ulink-12" href="/lfg">Marketing and go-to-market through LFG</a>
</div>
</div>

<div class="home-livebar"><LiveBar cta="watch" /></div>
</header>

<section class="rv stats" aria-label="By the numbers">
<div class="stack">
<div class="stat-n"><span data-count="1.6|1|M+">1.6M+</span></div>
<div class="dim">views on {SITE.channel}</div>
</div>
<div class="stack">
<div class="stat-n"><span data-count="20.7|1|K">20.7K</span></div>
<div class="dim">subscribers on {SITE.channel}</div>
</div>
<div class="stack">
<div class="stat-n"><span data-count="989|0|">989</span></div>
<div class="dim">videos across 2 channels</div>
</div>
<div class="stack">
<div class="stat-n"><span data-count="65000|0|+">65,000+</span></div>
<div class="dim">viewers on the DePIN Day: Seattle livestream on X</div>
</div>
</section>

<section class="rv" aria-label="DePIN Day: Seattle">
<div class="clip">
<picture class="pic"><source type="image/avif" srcset="/img/depin-stage-800.avif 800w, /img/depin-stage-1456.avif 1456w" sizes="(max-width: 800px) 100vw, 1600px"><source type="image/webp" srcset="/img/depin-stage-800.webp 800w, /img/depin-stage-1456.webp 1456w" sizes="(max-width: 800px) 100vw, 1600px"><img src="/img/depin-stage.jpg" width="1456" height="721" loading="lazy" decoding="async" class="zi depin-img"  alt="The DePIN Day: Seattle stage seen from the back of the room, Action on stage"></picture>
</div>
<div class="depin-text">
<h2 class="depin-h">DePIN Day: Seattle</h2>
<p class="depin-p">I co-organized it and hosted it, 2 years running. T-Mobile, HP and Borderless Capital on stage across 2024 and 2025. <a href="/work/depin-day-seattle" class="go uline">See the event</a></p>
</div>
</section>

<div class="band-wrap" aria-hidden="true">
<div class="band band-words">AI. DePIN. Crypto. In plain English. AI. DePIN. Crypto. In plain English.</div>
</div>
<section class="rv alt work-sec" id="work">
<h2 class="sec-h">The work</h2>
<div class="rows col">
{work.map((item) => (
<a href={item.href} class="row">
<span class:list={['mark', { 'mark-wide': item.wide }]} aria-hidden="true">{item.yt ? <Icon name="youtube" size={30} /> : item.logo ? <img src={item.logo} alt="" width="40" height="40" loading="lazy" decoding="async"> : item.mono}{item.live && <i class="mark-live"></i>}</span>
<span class="row-main"><span class="row-name">{item.name}</span><span class="row-role">{item.role}</span></span>
{item.href.startsWith('http') ? <Icon name="out" size={22} label="opens in a new tab" /> : <span class="row-go" aria-hidden="true"><Icon name="go" size={22} /></span>}
</a>
))}
</div>
</section>

<LatestVideo />

<TelegramNote />

<CallOut heading="Start with a video, an interview or a Space. If you want me on your stage after that, get in touch." links={[
  { label: `Watch ${SITE.channel}`, href: SITE.youtube, icon: 'youtube', title: `${SITE.channel} on YouTube` },
  { label: 'Get in touch', href: '/contact', icon: 'mail' },
  { label: SITE.email, href: `mailto:${SITE.email}` },
]} />
</Base>
