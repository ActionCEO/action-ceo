---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import CallOut from '../components/CallOut.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../site';
const roles = [
  ['Go-to-market strategy', 'How a launch reaches the right people, in what order, on which channels.'],
  ['Marketing and social', "Content, video and the social accounts, with the team I'm building out."],
  ['Communications and PR', 'The story, the announcements and the press around them.'],
  ['Founder interviews', 'I host them on LFG Action, including the DeAI Summit conversations.'],
];
---
<Base page="lfg">
<Header current="" />
<PageHero img="stage-keynote" big={1456} w={1456} h={813} alt="Action on a conference stage holding a microphone" pos="8% 40%" posPhone="27% 30%">
<img src="/img/lfg-wordmark-white.png" width="400" height="150" alt="Laissez-Faire Group (LFG) logo" class="hero-logo">
<h1 class="hero-h1">Laissez-Faire Group gets Web3 and AI teams to&nbsp;market.</h1>
<p class="hero-p">Go-to-market, marketing, PR and partnerships for teams in Web3, DePIN, fintech and decentralized AI. I'm a Partner and the Chief Communications Officer.</p>
<div class="hero-links"><a href="/contact" class="btn">Work with LFG</a><a href="https://laissezfairegroup.com" rel="noopener" class="btn-line">Visit laissezfairegroup.com</a></div>
</PageHero>
<section class="rv pad sec" aria-labelledby="fit-h">
<h2 class="sec-h" id="fit-h">Where I fit</h2>
<p class="sec-lead">I'm a Partner and the Chief Communications Officer. A lot sits under that title.</p>
<ul role="list" class="cards4">
{roles.map(([k, v]) => <li class="card"><h3 class="item-h">{k}</h3><p>{v}</p></li>)}
</ul>
<p class="sec-more"><a href={SITE.youtubeLfg} rel="noopener" class="btn-line"><Icon name="youtube" size={22} />Watch the interviews on LFG Action</a></p>
</section>
<CallOut heading="Tell me what you're launching." oneLine links={[{ label: 'Send it to me', href: '/contact', icon: 'mail' }, { label: 'See all my work', href: '/work' }]} />
</Base>
