---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import { SITE } from '../site';

---
<Base page="lfg">
<Header current="" />
<header style="background: #002346; padding: clamp(56px, 8vw, 120px) clamp(20px, 4.5vw, 64px); display: flex; flex-direction: column; gap: 28px; align-items: flex-start">
<h1 style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: clamp(40px, 6vw, 92px); line-height: 1.02; letter-spacing: -0.035em; max-width: 1100px; text-wrap: balance">Laissez-Faire Group gets Web3 and AI teams to market.</h1>
<p style="margin: 0; max-width: 640px; font-size: 20px; color: #E3E6E9">Laissez-Faire Group (LFG) does go-to-market, PR and partnerships for teams in Web3, DePIN, fintech and decentralized AI. We work across 55+ countries. I'm a Partner and the Chief Communications Officer.</p>
<div style="display: flex; flex-wrap: wrap; gap: 16px 32px; align-items: center"><a href="/contact" style="background: #69BE28; color: #06111F; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: 16px; padding: 16px 28px; border-radius: 2px">Work with LFG</a><a href="https://laissezfairegroup.com" rel="noopener" style="font-weight: 600; padding: 10px 0; border-bottom: 1px solid #FFFFFF">Visit laissezfairegroup.com</a></div>
</header>
<section class="rv" aria-label="My role" style="padding: 0 clamp(20px, 4.5vw, 64px) 96px; display: flex; flex-wrap: wrap; gap: 40px 64px; align-items: center">
<picture style="display: contents"><source type="image/avif" srcset="/img/stage-keynote-800.avif 800w, /img/stage-keynote-1376.avif 1376w" sizes="(max-width: 800px) 100vw, 640px"><source type="image/webp" srcset="/img/stage-keynote-800.webp 800w, /img/stage-keynote-1376.webp 1376w" sizes="(max-width: 800px) 100vw, 640px"><img src="/img/stage-keynote.jpg" width="1376" height="768" loading="lazy" decoding="async" alt="Action on a conference stage holding a microphone" style="flex: 2 1 360px; min-width: 0; width: 100%; aspect-ratio: 4 / 3; object-fit: cover"></picture>
<div style="flex: 3 1 440px; min-width: 0; display: flex; flex-direction: column; gap: 20px">
<h2 style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: clamp(28px, 3.2vw, 44px); line-height: 1.02; letter-spacing: -0.035em; ">Where I fit</h2>
<p style="margin: 0; max-width: 620px; font-size: 20px; color: #D5D8DB">I'm a Partner and the Chief Communications Officer. I also host the interviews on LFG Action. <a href="https://www.youtube.com/@LFGAction" rel="noopener" style="border-bottom: 1px solid #FFFFFF">Watch on LFG Action</a></p>
</div>
</section>
<section class="rv" style="background: #002346; padding: 110px clamp(20px, 4.5vw, 64px); display: flex; flex-direction: column; gap: 28px; align-items: flex-start">
<h2 style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-weight: 800; font-size: clamp(34px, 4.8vw, 68px); line-height: 1.02; letter-spacing: -0.035em; max-width: 1000px">Tell me what you're launching.</h2>
<a href="/contact" style="font-weight: 600; padding: 10px 0; border-bottom: 1px solid #FFFFFF">Send it to me</a>
</section>
</Base>
