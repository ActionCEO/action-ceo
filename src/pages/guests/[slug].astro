---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { getCollection } from 'astro:content';
import { cut } from '../../lib/content';
export async function getStaticPaths() { return (await getCollection('guests')).map((guest) => ({ params: { slug: guest.id }, props: { guest } })); }
const { guest } = Astro.props;
const eps = (await getCollection('episodes')).filter((e) => e.data.guests.some((g) => g.id === guest.id));
// Description: 70 to 155 characters, never cut in the middle of a word. The role is used only when all of it fits.
// A short name with no role gets the longer ending, so the text never falls under 70.
const gName = cut(guest.data.name, 60), tail = ', a guest on shows hosted by Action.';
const short = ' See every episode they joined.', long = ' See every episode they joined and what they talked about.';
const role = guest.data.role?.trim().replace(/[.,\s]+$/, '');
const who = role && `${gName}, ${role}${tail}${short}`.length <= 155 ? `${gName}, ${role}` : gName;
const desc = who + tail + ((who + tail + long).length <= 155 ? long : short);
---
<Base title={`${cut(guest.data.name, 30)} | Guest of Crypto Host Action`} description={desc} path={`/guests/${guest.id}`} ogImage="/og/shows.png">
<Header current="Shows" />
<section class="pad guest">
  <h1 class="guest-h1">{guest.data.name}</h1>
  {guest.data.role && <p class="para-20">{guest.data.role}</p>}
  {guest.data.url && <a class="ulink" href={guest.data.url} rel="noopener">Website</a>}
  <div class="guest-eps">{eps.map((e) => <a href={`/episodes/${e.id}`} class="guest-ep">{e.data.title}</a>)}</div>
</section>
</Base>
