---
// The nav is drawn 1 time per page by the layout (src/layouts/Base.astro), outside <main>, with the `nav` prop.
// Pages still place <Header /> where their content starts. There it leaves only the skip-link target and, on Home,
// a spacer that keeps the hero text clear of the nav that sits over the hero photo.
// On phones the links fold into a menu button. Without JavaScript the links stay visible.
const { current = '', nav = false, overlay = false } = Astro.props;
const NAV = [['Work', '/work'], ['Shows', '/shows'], ['Speaking', '/speaking'], ['Blog', '/blog'], ['About', '/about'], ['Contact', '/contact']];
const home = /^\/(index\.html)?$/.test(Astro.url.pathname);
---
{nav ? (
<nav aria-label="Main" class:list={['pad', 'site-nav', { 'nav-over': overlay }]}>
  <a href="/" aria-label="Action, home" style="display: flex; padding: 6px 0"><img src="/img/action-wordmark-white.png" alt="Action" width="120" height="32" style="display: block; height: 32px; width: auto"></a>
  <button type="button" class="menu-btn" aria-expanded="false" aria-controls="nav-links" data-menu>
    <span class="menu-bars" aria-hidden="true"><span></span><span></span><span></span></span><span class="menu-label">Menu</span>
  </button>
  <div id="nav-links" class="nav-links">
    {NAV.map(([n, h]) => <a href={h} aria-current={n === current ? 'page' : undefined} class:list={{ cur: n === current }}>{n}</a>)}
  </div>
</nav>
) : (
<Fragment>{home && <div class="nav-room" aria-hidden="true"></div>}<span id="content" tabindex="-1"></span></Fragment>
)}
