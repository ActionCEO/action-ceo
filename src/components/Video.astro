---
// Click-to-play YouTube. Nothing from the player loads until the button is pressed.
const { id, title, start = 0, poster = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`, eager = false } = Astro.props;
---
<div data-yt={id} data-start={start} style="position: relative; aspect-ratio: 16 / 9; background: #002346; overflow: hidden; width: 100%">
  <img src={poster} alt="" width="1280" height="720" loading={eager ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover">
  <button type="button" data-yt-play aria-label={`Play video: ${title}`} style="position: absolute; left: 24px; bottom: 24px; display: flex; align-items: center; gap: 14px; background: #FFFFFF; color: #06111F; border: 0; padding: 14px 20px; min-height: 52px; cursor: pointer; font-family: 'Montserrat', Arial, sans-serif; font-weight: 700; font-size: 16px">
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3l15 9-15 9z" fill="#06111F"></path></svg><span data-yt-label>Play video</span>
  </button>
</div>
