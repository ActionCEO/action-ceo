---
// YouTube player. The poster paints first with a "Load video" button over it. site.js shows the button, and
// pressing it adds the real iframe with no autoplay, so the visitor's first play is YouTube's own button
// (that is what counts as a view). Outside the EU, EEA, UK and Switzerland site.js also adds the iframe by itself.
// Without JavaScript the button stays hidden, the poster stays and a link goes to the video on YouTube.
import { ytThumb, ytWatch } from '../lib/youtube';
const { id, title, start = 0, poster, eager = false } = Astro.props;
const fallback = ytThumb(id, 'hqdefault');
const src = poster ?? ytThumb(id, 'maxresdefault');
// YouTube answers a missing maxresdefault with a 404 that still carries a 120x90 grey image, so check the size as well as the error.
const swap = "this.onload=this.onerror=null;this.src=this.dataset.fallback";
---
<div class="yt-box" data-yt={id} data-start={start} data-title={title}>
  <img src={src} data-fallback={fallback} onload={`if(this.naturalWidth<300){${swap}}`} onerror={swap} alt="" width="1280" height="720" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" referrerpolicy="no-referrer" class="fill">
  <button type="button" class="ytplay" data-yt-play hidden aria-label={`Load video: ${title}`}><span aria-hidden="true"><svg viewBox="0 0 24 24" width="32" height="32" focusable="false"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span></button>
  <noscript><a class="yt-nojs" href={ytWatch(id, Number(start) || undefined)} rel="noopener">Watch on YouTube: {title}</a></noscript>
</div>
