---
// Home: the newest videos as cards. Each card opens the video's post (video, key points, transcript).
import { getCollection } from 'astro:content';
import VideoCard from './VideoCard.astro';
import Icon from './Icon.astro';
import { SITE } from '../site';
const vids = (await getCollection('videos')).filter((v) => v.data.channel === 'ActionCrypto' && v.data.series !== 'depin-day' && !v.id.startsWith('SAMPLE')).sort((a, b) => +b.data.publishedAt - +a.data.publishedAt).slice(0, 3);
const F = "'Montserrat', Arial, sans-serif";
---
<section class="rv pad" aria-label="Latest videos" style="padding-bottom: 120px; display: flex; flex-direction: column; gap: 32px">
  <div style="display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px 32px">
    <h2 style={`margin: 0; font-family: ${F}; font-weight: 800; font-size: clamp(28px, 3.2vw, 44px); letter-spacing: -0.025em`}>Latest breakdowns</h2>
    <div style="display: flex; flex-wrap: wrap; gap: 4px 28px">
      <a href="/blog" style="font-weight: 600; padding: 10px 0; border-bottom: 1px solid #FFFFFF">All videos, written out</a>
      <a href={`${SITE.youtube}?sub_confirmation=1`} rel="noopener" style="display: inline-flex; align-items: center; gap: 8px; font-weight: 600; padding: 10px 0; border-bottom: 1px solid #FFFFFF"><Icon name="youtube" size={20} />Subscribe to {SITE.channel}</a>
    </div>
  </div>
  <div class="vgrid">
    {vids.map((v) => <VideoCard video={v} />)}
  </div>
</section>
