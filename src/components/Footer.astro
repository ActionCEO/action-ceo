---
import { SITE } from '../site';
import Icon from './Icon.astro';
// Each social link shows its logo and which account it is, on every screen. Hovering shows the full name.
// On a phone they sit 2 to a line: the 2 YouTube channels, the 2 X accounts, then LinkedIn and Instagram.
const L = [
  { icon: 'youtube', label: `${SITE.channel} on YouTube`, short: SITE.channel, href: SITE.youtube },
  { icon: 'youtube', label: 'LFG Action on YouTube', short: 'LFG Action', href: SITE.youtubeLfg },
  { icon: 'x', label: '@ActionCEO on X', short: '@ActionCEO', href: SITE.x },
  { icon: 'x', label: '@LFGAction on X', short: '@LFGAction', href: SITE.xLfg },
  { icon: 'linkedin', label: 'Action on LinkedIn', short: 'LinkedIn', href: SITE.linkedin },
  { icon: 'instagram', label: 'Action on Instagram', short: 'Instagram', href: SITE.instagram },
  ...(SITE.telegram ? [{ icon: 'telegram', label: 'Action on Telegram', short: 'Telegram', href: SITE.telegram }] : []),
];
---
<footer data-pagefind-ignore class="pad site-foot">
  <div class="foot-top">
    <a class="foot-home" href="/" aria-label="Action, home"><img class="foot-logo" src="/img/action-wordmark-white.png" alt="Action" width="120" height="32" loading="lazy"></a>
    <p class="foot-tag">AI, DePIN and crypto in plain English.</p>
  </div>
  <ul class="socials" aria-label="Follow Action">
    {L.map((l) => (
      <li><a href={l.href} target="_blank" rel="noopener" aria-label={`${l.label}, opens in a new tab`} title={l.label} class="soc"><Icon name={l.icon} size={22} /><span class="soc-t">{l.short}</span></a></li>
    ))}
  </ul>
  <div class="foot-bar">
    <a class="foot-mail" href={`mailto:${SITE.email}`}><Icon name="mail" size={18} />{SITE.email}</a>
    <a class="foot-lfg" href="/lfg" title="Laissez-Faire Group"><img class="foot-lfg-img" src="/img/lfg-wordmark-white.png" alt="Laissez-Faire Group" width="400" height="150" loading="lazy" decoding="async"></a>
    <a class="foot-link" href="/privacy">Terms and privacy</a>
    <button type="button" data-consent-reset hidden class="foot-btn">Cookie settings</button>
    <span class="foot-copy">© {new Date().getFullYear()} {SITE.company}</span>
  </div>
</footer>
